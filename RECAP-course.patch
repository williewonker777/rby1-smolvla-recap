+import importlib.util
+import os
+from pathlib import Path
+import unittest
+
+import numpy as np
+import torch
+
+SPEC = importlib.util.spec_from_file_location('recap_value', Path(__file__).parents[1] / 'scripts/recap_value.py')
+m = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(m)
+
+
+class ValueTests(unittest.TestCase):
+    def test_canonical_first_success_and_no_mutation(self):
+        raw = {'success_original': np.array([[0], [0], [1], [1]]),
+               'observation.state': np.zeros((4, 16)), 'action': np.ones((4, 16))}
+        self.assertEqual(m.canonical_oracle_terminal(raw), 2)
+        self.assertEqual(len(raw['action']), 4)
+        for flags in [np.zeros(4, dtype=int), [0, 2, 1, 1], np.ones((4, 2)), [0., 0., 1., 1.]]:
+            with self.subTest(flags=flags), self.assertRaises(ValueError):
+                m.canonical_oracle_terminal(dict(raw, success_original=flags))
+        with self.assertRaises(ValueError):
+            m.canonical_oracle_terminal({})
+        with self.assertRaises(ValueError):
+            m.canonical_oracle_terminal(dict(raw, action=np.zeros((3, 16))))
+
+    @unittest.skipUnless(os.environ.get('RECAP_ORACLE_SMOKE_NPZ'), 'set RECAP_ORACLE_SMOKE_NPZ for real T1 evidence')
+    def test_real_t1_oracle(self):
+        with np.load(os.environ['RECAP_ORACLE_SMOKE_NPZ'], allow_pickle=False) as raw:
+            k = m.canonical_oracle_terminal(raw)
+            self.assertEqual(k, 257)
+            self.assertEqual(len(raw['action']), 258)
+            self.assertEqual(raw['observation.state'][:k+1].shape[0], k+1)
+            self.assertEqual(raw['action'][:k].shape[0], k)
+
+    def test_returns_terminal_penalty_once_and_bins(self):
+        np.testing.assert_allclose(m.normalized_returns(2, 4, True), [-.25, -.125, 0])
+        np.testing.assert_allclose(m.normalized_returns(2, 4, False), [-.75, -.625, -.5])
+        np.testing.assert_allclose(m.normalized_returns(4, 4, False), [-1, -.875, -.75, -.625, -.5])
+        np.testing.assert_array_equal(m.categorical_targets([-1, -.5, 0]), [0, 100, 200])
+        np.testing.assert_allclose(m.normalized_returns(0, 4, True), [0])
+        np.testing.assert_allclose(m.normalized_returns(0, 4, False), [-.5])
+        for args in [(5, 4, True), (1, 0, True), (True, 4, True), (1, 4, 1)]:
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                m.normalized_returns(*args)
+        for invalid in [[-1.001], [.001], [np.nan], [[-.5]], [True]]:
+            with self.assertRaises(ValueError):
+                m.categorical_targets(invalid)
+
+    def test_advantage_exact_terminal_no_bootstrap(self):
+        v = [-.8, -.7, -.6, -.5, -.9]
+        # t=0 bootstraps to 2, t=1 to 3; t=2 lands exactly on T=4.
+        np.testing.assert_allclose(m.terminal_advantages(v, 4, 4, True, 2), [-.05, -.05, .35, .375])
+        np.testing.assert_allclose(m.terminal_advantages(v, 4, 4, False, 2), [-.05, -.05, -.15, -.125])
+        np.testing.assert_allclose(m.terminal_advantages([-.2, -.9], 1, 4, True), [.075])
+        np.testing.assert_array_equal(m.terminal_advantages([-.2], 0, 4, True), [])
+        for bad in [[-.5]*4, [-.5]*6, [float('nan')]*5, [1.]*5]:
+            with self.assertRaises(ValueError):
+                m.terminal_advantages(bad, 4, 4, True)
+        with self.assertRaises(ValueError):
+            m.terminal_advantages(v, 4, 4, True, 0)
+
+    def test_default_fifty_step_boundary(self):
+        values = np.full(52, -.5)
+        # T=51: t=0 uses a 50-step bootstrap; t=1 hits terminal exactly.
+        result = m.terminal_advantages(values, 51, 100, True)
+        self.assertAlmostEqual(result[0], -.25)
+        self.assertAlmostEqual(result[1], .25)
+        self.assertAlmostEqual(result[-1], .495)
+        values[-1] = 0
+        np.testing.assert_allclose(result, m.terminal_advantages(values, 51, 100, True))
+
+    def test_task_thresholds_do_not_pool(self):
+        labels, report = m.task_indicators([0, 1, 2, 10, 11, 12], ['T1']*3+['T2']*3,
+                                          [True]*6, required_tasks=['T1', 'T2'])
+        np.testing.assert_array_equal(labels, [False, False, True]*2)
+        self.assertAlmostEqual(report['T1']['epsilon'], 1.2)
+        self.assertAlmostEqual(report['T2']['epsilon'], 11.2)
+
+    def test_indicator_strict_ties_and_correction(self):
+        a = [1, 2, 2, 2, 3, 0, 0, 0]
+        auto = [True]*5+[False]*3
+        labels, report = m.task_indicators(a, ['T1']*8, auto, required_tasks=['T1'],
+                                          correction_verified=[False]*6+[True]*2,
+                                          correction_pure=[False]*7+[True])
+        np.testing.assert_array_equal(labels, [False, False, False, False, True, False, False, True])
+        self.assertEqual(report['T1'], dict(epsilon=2., autonomous_count=5, positive_count=1,
+                                          negative_count=4, tie_count=3, forced_positive_count=1))
+        # All raw advantages positive is valid: thresholded classes are what matter.
+        m.task_indicators([1, 2, 3], ['T1']*3, [True]*3, required_tasks=['T1'])
+
+    def test_indicator_fail_closed(self):
+        base = dict(advantages=[1, 2, 3], task_ids=['T1']*3, autonomous=[True]*3, required_tasks=['T1'])
+        bads = [dict(advantages=[1, 1, 1]), dict(autonomous=[False]*3), dict(autonomous=[1]*3),
+                dict(task_ids=['T11']*3), dict(task_ids=['T1']), dict(required_tasks=['T1', 'T2']),
+                dict(correction_pure=[False]*3), dict(percentile=100),
+                dict(correction_verified=[False]*3, correction_pure=[True]*3),
+                dict(correction_verified=[True]*3, correction_pure=[False]*3)]
+        for override in bads:
+            with self.subTest(override=override), self.assertRaises(ValueError):
+                m.task_indicators(**(base | override))
+
+    def test_macro_equal_episode_then_task_weight(self):
+        episodes = [dict(task='T1', episode_id='a', targets=[0]*100, predictions=[-.1]*100, training_fold_mean=-.5),
+                    dict(task='T1', episode_id='b', targets=[0], predictions=[-.9], training_fold_mean=-.5),
+                    dict(task='T2', episode_id='c', targets=[0], predictions=[-.1], training_fold_mean=-.5)]
+        result = m.oof_macro_gate(episodes, ['T1', 'T2'])
+        self.assertAlmostEqual(result['model_mae'], .3)
+        self.assertAlmostEqual(result['constant_mae'], .5)
+        self.assertTrue(result['passed'])
+        for prediction, passed in [(-.49, True), (-.491, False)]:
+            result = m.oof_macro_gate([episodes[1] | dict(predictions=[prediction])], ['T1'])
+            self.assertEqual(result['passed'], passed)
+        zero = m.oof_macro_gate([episodes[1] | dict(training_fold_mean=0, predictions=[0])], ['T1'])
+        self.assertFalse(zero['passed'])
+        self.assertEqual(zero['reason'], 'zero_constant_comparator')
+        for invalid in [[], [episodes[0], episodes[0]], [episodes[0] | dict(predictions=[0])],
+                        [episodes[0] | dict(training_fold_mean=np.nan)], [{}]]:
+            with self.assertRaises(ValueError):
+                m.oof_macro_gate(invalid, ['T1'])
+
+    def test_critic_cpu_gradient_and_validation(self):
+        torch.manual_seed(1000)
+        torch.set_num_threads(1)
+        model = m.DistributionalValue().cpu()
+        images, state, task = torch.rand(2, 3, 3, 16, 16), torch.zeros(2, 16), torch.tensor([0, 9])
+        logits = model(images, state, task)
+        self.assertEqual(tuple(logits.shape), (2, 201))
+        loss = torch.nn.functional.cross_entropy(logits, torch.tensor(m.categorical_targets([-.5, 0])))
+        optimizer = torch.optim.Adam(model.parameters(), lr=.001)
+        before = model.head[-1].weight.detach().clone()
+        loss.backward()
+        for parameter in model.parameters():
+            self.assertIsNotNone(parameter.grad)
+            self.assertTrue(torch.isfinite(parameter.grad).all())
+        optimizer.step()
+        self.assertFalse(torch.equal(before, model.head[-1].weight))
+        values = model.expected_value(images, state, task)
+        self.assertTrue(torch.isfinite(values).all())
+        self.assertTrue(((values >= -1) & (values <= 0)).all())
+        for args in [(images[:, :2], state, task), (images, state[:, :15], task),
+                     (images, state, task.float()), (images, state, torch.tensor([0, 10])),
+                     (images*0+float('nan'), state, task), (images+1, state, task)]:
+            with self.assertRaises(ValueError):
+                model(*args)
+
+
+if __name__ == '__main__':
+    unittest.main()
