+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+from PIL import Image
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts'))
+from audit_oracle_pngs import CAMERAS, audit
+
+
+class OraclePngAuditTests(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.episode = self.root / 'episode-one'
+        self.episode.mkdir()
+        (self.episode / 'episode.json').write_text(json.dumps({
+            'status': 'saved', 'frames': 2, 'fps': 15, 'cameras': CAMERAS,
+            'camera_sizes': {camera: [3, 5] for camera in CAMERAS},
+        }))
+        for camera in CAMERAS:
+            (self.episode / camera).mkdir()
+            for i in range(2):
+                Image.new('RGB', (5, 3), (i, 2, 3)).save(self.episode / camera / f'{i:06d}.png')
+
+    def test_matches_course_counts_and_shape(self):
+        result = audit(self.root, expected=1)
+        self.assertTrue(result['passed'])
+        self.assertEqual(result['images_checked'], 6)
+        self.assertFalse(audit(self.root, expected=50)['passed'])
+
+    def test_rejects_idat_crc_without_changing_frame(self):
+        path = self.episode / 'left_hand' / '000001.png'
+        contents = bytearray(path.read_bytes())
+        contents[contents.index(b'IDAT') + 4] ^= 1
+        path.write_bytes(contents)
+        result = audit(self.root, expected=1)
+        self.assertFalse(result['passed'])
+        self.assertEqual(result['images_checked'], 6)
+        fault, = result['violations']
+        self.assertEqual(fault['frame'], 'left_hand/000001.png')
+        self.assertIn('checksum', fault['error'])
+        self.assertEqual(path.read_bytes(), contents)
+
+    def test_missing_frame_and_wrong_dimensions_are_rejected(self):
+        (self.episode / 'right_hand' / '000001.png').unlink()
+        Image.new('RGB', (5, 4)).save(self.episode / 'first_person' / '000000.png')
+        result = audit(self.root, expected=1)
+        self.assertFalse(result['passed'])
+        self.assertEqual(len(result['violations']), 2)
+
+
+if __name__ == '__main__':
+    unittest.main()
