@@ -0,0 +1,219 @@
+"""RECAP value primitives; no I/O, split assignment, actor fitting or simulator code.
+
+Callers own episode-disjoint cross-fitting and source/index joins. Values and
+returns use [-1, 0]; actor arrays exclude the terminal observation. Task IDs for
+the critic are zero-based in TASKS order. Camera inputs are normalized floats.
+"""
+import numpy as np
+import torch
+from torch import nn
+
+TASKS = tuple(f"T{i}" for i in range(1, 11))
+NUM_BINS = 201
+
+
+def _integer(value, name, minimum=0):
+    if isinstance(value, (bool, np.bool_)) or not isinstance(value, (int, np.integer)) or value < minimum:
+        raise ValueError(f"{name} must be an integer >= {minimum}")
+    return int(value)
+
+
+def _vector(value, name, bounds=None):
+    result = np.asarray(value)
+    if result.ndim != 1 or result.dtype.kind not in 'fiu' or not np.isfinite(result).all():
+        raise ValueError(f"{name} must be a finite numeric vector")
+    result = result.astype(np.float64)
+    if bounds is not None and ((result < bounds[0]).any() or (result > bounds[1]).any()):
+        raise ValueError(f"{name} outside {bounds}")
+    return result
+
+
+def canonical_oracle_terminal(trajectory):
+    """First success row k: retain observations [:k+1], actor actions [:k].
+
+    Accept the recorder's integer 0/1 success column as well as boolean flags.
+    Require aligned state/action arrays; fail closed if success is absent. Do not
+    modify the input or the immutable B0 export. Later raw rows are not targets.
+    """
+    required = ('success_original', 'observation.state', 'action')
+    if any(key not in trajectory for key in required):
+        raise ValueError(f"oracle trajectory requires {required}")
+    flags = np.asarray(trajectory['success_original'])
+    if flags.ndim == 2 and flags.shape[1] == 1:
+        flags = flags[:, 0]
+    if flags.ndim != 1 or flags.dtype.kind not in 'biu' or not np.isin(flags, [0, 1]).all():
+        raise ValueError('success_original must be a boolean or integer 0/1 column')
+    for key in required[1:]:
+        array = np.asarray(trajectory[key])
+        if array.ndim != 2 or len(array) != len(flags) or array.dtype.kind not in 'fiu' or not np.isfinite(array).all():
+            raise ValueError(f'{key} must be a finite aligned matrix')
+    indices = np.flatnonzero(flags)
+    if not len(indices):
+        raise ValueError('oracle has no successful terminal observation')
+    return int(indices[0])
+
+
+def normalized_returns(action_count, horizon, success):
+    """Return G_t/(2H) for every observation t=0..T, including terminal.
+
+    T=0 is valid for target math, not a trainable actor episode. Failure receives
+    -H exactly once at T, whether early termination or full-horizon timeout.
+    """
+    t = _integer(action_count, 'action_count')
+    h = _integer(horizon, 'horizon', 1)
+    if t > h or not isinstance(success, (bool, np.bool_)):
+        raise ValueError('require T <= H and boolean success')
+    return (-(t - np.arange(t + 1, dtype=np.float64)) - (0 if success else h)) / (2 * h)
+
+
+def categorical_targets(returns):
+    """201 uniform bins; nearest bin, exact halfway ties go toward zero."""
+    values = _vector(returns, 'returns', (-1, 0))
+    return np.floor((values + 1) * (NUM_BINS - 1) + .5).astype(np.int64)
+
+
+def terminal_advantages(values, action_count, horizon, success, n_step=50):
+    """Actor-frame advantages [T]; require V for T+1 observations.
+
+    No bootstrap when t+N == T or t+N > T. Even V(o_T) is ignored there.
+    """
+    returns = normalized_returns(action_count, horizon, success)
+    v = _vector(values, 'values', (-1, 0))
+    n = _integer(n_step, 'n_step', 1)
+    if len(v) != len(returns):
+        raise ValueError('values must contain exactly T+1 observation predictions')
+    advantages = returns[:-1] - v[:-1]
+    starts = np.arange(action_count)
+    boot = starts + n < action_count
+    advantages[boot] = -n / (2 * horizon) + v[starts[boot] + n] - v[starts[boot]]
+    return advantages
+
+
+def _bool_vector(value, name, length):
+    result = np.asarray(value)
+    if result.dtype.kind != 'b' or result.shape != (length,):
+        raise ValueError(f'{name} must be a boolean vector of length {length}')
+    return result
+
+
+def task_indicators(advantages, task_ids, autonomous, *, correction_verified=None,
+                    correction_pure=None, percentile=60, required_tasks=TASKS):
+    """Threshold each task using autonomous frames only, then label all frames.
+
+    Strict A>epsilon, deterministic NumPy linear percentile; ties are negative.
+    Both thresholded classes must occur in autonomous support for every required
+    task. Mathematical signs of raw A are not the viability criterion. A forced
+    positive requires BOTH verified correction provenance and a pure correction
+    target chunk (caller has already masked the shared source-boundary tail).
+    Optional flags must be supplied together. Ordinary oracle is not overridden.
+    """
+    a = _vector(advantages, 'advantages')
+    tasks = np.asarray(task_ids)
+    if tasks.shape != a.shape or tasks.dtype.kind not in 'US' or not set(tasks).issubset(TASKS):
+        raise ValueError('task_ids must be aligned T1..T10 strings')
+    expected = tuple(required_tasks)
+    if not expected or len(set(expected)) != len(expected) or not set(expected).issubset(TASKS) or not set(tasks).issubset(expected):
+        raise ValueError('required_tasks must cover all observed tasks without duplicates')
+    auto = _bool_vector(autonomous, 'autonomous', len(a))
+    if isinstance(percentile, (bool, np.bool_)) or not np.isfinite(percentile) or not 0 < percentile < 100:
+        raise ValueError('percentile must lie strictly between 0 and 100')
+    if (correction_verified is None) != (correction_pure is None):
+        raise ValueError('both correction provenance flags are required together')
+    forced = np.zeros(len(a), dtype=bool)
+    if correction_verified is not None:
+        verified = _bool_vector(correction_verified, 'correction_verified', len(a))
+        pure = _bool_vector(correction_pure, 'correction_pure', len(a))
+        if (pure & ~verified).any() or (auto & (verified | pure)).any():
+            raise ValueError('inconsistent correction/autonomous provenance')
+        forced = verified & pure
+    indicators = np.zeros(len(a), dtype=bool)
+    report = {}
+    for task in expected:
+        selected = tasks == task
+        support = a[selected & auto]
+        if not len(support):
+            raise ValueError(f'{task}: empty autonomous support')
+        epsilon = float(np.percentile(support, percentile, method='linear'))
+        positives = int(np.count_nonzero(support > epsilon))
+        if positives in (0, len(support)):
+            raise ValueError(f'{task}: collapsed thresholded autonomous classes')
+        indicators[selected] = a[selected] > epsilon
+        report[task] = dict(epsilon=epsilon, autonomous_count=len(support),
+                            positive_count=positives, negative_count=len(support)-positives,
+                            tie_count=int(np.count_nonzero(support == epsilon)),
+                            forced_positive_count=int(np.count_nonzero(forced & selected)))
+    return indicators | forced, report
+
+
+def oof_macro_gate(episodes, required_tasks=TASKS):
+    """Gate OOF predictions against caller-supplied TRAINING-FOLD task means.
+
+    Each record: task, episode_id (globally unique), targets [observations],
+    predictions [observations], training_fold_mean scalar. Caller must prove
+    fold isolation; it cannot be inferred from arrays. Average frame MAE within
+    episode, episode MAE within task, then equal weight tasks. No pooled frames.
+    """
+    expected = tuple(required_tasks)
+    if not expected or len(set(expected)) != len(expected) or not set(expected).issubset(TASKS):
+        raise ValueError('invalid required_tasks')
+    errors = {task: [] for task in expected}
+    seen = set()
+    for episode in episodes:
+        keys = ('task', 'episode_id', 'targets', 'predictions', 'training_fold_mean')
+        if any(key not in episode for key in keys):
+            raise ValueError(f'episode requires {keys}')
+        task, identity = episode['task'], episode['episode_id']
+        if task not in errors or not isinstance(identity, str) or not identity or identity in seen:
+            raise ValueError('unknown task or invalid/duplicate episode identity')
+        seen.add(identity)
+        target = _vector(episode['targets'], 'targets', (-1, 0))
+        pred = _vector(episode['predictions'], 'predictions', (-1, 0))
+        mean = np.asarray(episode['training_fold_mean'])
+        if mean.shape != () or mean.dtype.kind not in 'fiu' or not np.isfinite(mean) or not -1 <= mean <= 0:
+            raise ValueError('training_fold_mean must be a normalized finite scalar')
+        if not len(target) or pred.shape != target.shape:
+            raise ValueError('OOF target/prediction alignment is empty or invalid')
+        errors[task].append((float(np.abs(target-pred).mean()), float(np.abs(target-mean).mean())))
+    if any(not rows for rows in errors.values()):
+        raise ValueError('missing task OOF support')
+    per_task = {task: np.mean(rows, axis=0) for task, rows in errors.items()}
+    model, constant = np.mean(list(per_task.values()), axis=0)
+    return dict(model_mae=float(model), constant_mae=float(constant),
+                passed=bool(constant > 0 and model <= .98 * constant),
+                reason='zero_constant_comparator' if constant == 0 else ('passed' if model <= .98 * constant else 'insufficient_improvement'),
+                per_task={task: {'model_mae': float(row[0]), 'constant_mae': float(row[1]), 'episodes': len(errors[task])}
+                          for task, row in per_task.items()})
+
+
+class DistributionalValue(nn.Module):
+    """Small shared RGB CNN + observed state/task critic; no privileged features.
+
+    Inputs cameras [B,3,3,H,W] in [0,1], state [B,16] finite floats, task_id
+    [B] int64 in [0,9]. View order must be fixed by caller. Forward emits logits
+    [B,201] for cross_entropy(categorical_targets); expected_value emits [B].
+    """
+    def __init__(self):
+        super().__init__()
+        self.camera = nn.Sequential(nn.Conv2d(3, 16, 5, stride=2, padding=2), nn.ReLU(),
+                                    nn.Conv2d(16, 32, 3, stride=2, padding=1), nn.ReLU(),
+                                    nn.AdaptiveAvgPool2d(1), nn.Flatten())
+        self.state = nn.Sequential(nn.Linear(16, 32), nn.ReLU())
+        self.task = nn.Embedding(len(TASKS), 16)
+        self.head = nn.Sequential(nn.Linear(3*32+32+16, 128), nn.ReLU(), nn.Linear(128, NUM_BINS))
+        self.register_buffer('bins', torch.linspace(-1, 0, NUM_BINS))
+
+    def forward(self, cameras, state, task_id):
+        if cameras.ndim != 5 or cameras.shape[1:3] != (3, 3) or min(cameras.shape[3:]) < 1 or cameras.shape[0] < 1:
+            raise ValueError('cameras must have shape [B,3,3,H,W], B,H,W > 0')
+        batch = cameras.shape[0]
+        if state.shape != (batch, 16) or task_id.shape != (batch,) or task_id.dtype != torch.int64:
+            raise ValueError('require state [B,16] and int64 task_id [B]')
+        if not cameras.is_floating_point() or not state.is_floating_point() or not torch.isfinite(cameras).all() or not torch.isfinite(state).all():
+            raise ValueError('camera/state must be finite floating point')
+        if (cameras < 0).any() or (cameras > 1).any() or (task_id < 0).any() or (task_id >= len(TASKS)).any():
+            raise ValueError('camera range or task ID outside contract')
+        features = self.camera(cameras.reshape(batch*3, 3, *cameras.shape[3:])).reshape(batch, -1)
+        return self.head(torch.cat((features, self.state(state), self.task(task_id)), dim=1))
+
+    def expected_value(self, cameras, state, task_id):
+        return (self(cameras, state, task_id).softmax(dim=-1) * self.bins).sum(dim=-1)
