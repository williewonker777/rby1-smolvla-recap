--- /dev/null
+++ b/vla_lab/tests/test_build_recap_mixed.py
@@ -0,0 +1,159 @@
+"""CPU corpus provenance/terminal contracts and real pinned aggregation API."""
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+import numpy as np
+import pytest
+
+SCRIPTS = Path(__file__).resolve().parents[1] / "scripts"
+spec = importlib.util.spec_from_file_location("build_recap_mixed", SCRIPTS / "build_recap_mixed.py")
+mixed = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mixed)
+sys.path.insert(0, str(SCRIPTS.parents[1] / "scripts"))
+import rby1_format as R
+
+
+def write_json(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value))
+
+
+def create_dataset(root, states, actions):
+    from lerobot.datasets.lerobot_dataset import LeRobotDataset
+    features = {key: {"dtype": "float32", "shape": (16,), "names": R.NAMES}
+                for key in ("action", "observation.state")}
+    features.update({f"observation.images.{key}": {"dtype": "video", "shape": (*shape, 3),
+                     "names": ["height", "width", "channels"]} for key, shape in R.IMAGE_SHAPES.items()})
+    ds = LeRobotDataset.create(repo_id="local/mixed-fixture", root=root, fps=15, features=features,
+         robot_type="rby1", video_backend="pyav", vcodec="libsvtav1", image_writer_threads=3)
+    try:
+        for state, action in zip(states, actions):
+            ds.add_frame({"task": "put the black bowl on the plate.", "observation.state": state, "action": action,
+                **{f"observation.images.{key}": np.zeros((*shape, 3), dtype=np.uint8) for key, shape in R.IMAGE_SHAPES.items()}})
+        ds.save_episode(parallel_encoding=False)
+    finally:
+        ds.stop_image_writer()
+        ds.finalize()
+
