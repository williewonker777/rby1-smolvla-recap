+"""Validate and summarize complete B0 public evaluation evidence, never training data.
+
+Usage: python vla_lab/scripts/summarize_recap_b0.py --eval EVAL_ROOT
+JSON goes to stdout; source files are never modified. Rates use all episodes.
+"""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import re
+import statistics
+
+import numpy as np
+
+TASKS = tuple(f"T{i}" for i in range(1, 11))
+SEEDS = frozenset(range(100000, 100050))
+STAGES = ("approach", "grasp", "transport", "place", "timeout", "unknown")
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def read_json(path):
+    return json.loads(path.read_text())
+
+
+def summarize(root, failure_analysis=None):
+    root = Path(root).expanduser().resolve()
+    analysis_path = Path(failure_analysis).expanduser().resolve() if failure_analysis else root / "failure_analysis.json"
+    raw = analysis_path.read_bytes()
+    analysis = json.loads(raw)
+    require(isinstance(analysis, dict), "failure_analysis must be an object")
+    require(isinstance(analysis.get("table"), list) and isinstance(analysis.get("episodes"), list),
+            "failure_analysis needs table and episodes lists")
+    require(set(root.glob("*/episodes.json")) == {root / t / "episodes.json" for t in TASKS},
+            "require exactly T1..T10 episode files")
+    outcomes, videos = {}, {}
+    for task in TASKS:
+        rows = read_json(root / task / "episodes.json")
+        require(isinstance(rows, list), f"{task}: episodes must be a list")
+        values = {}
+        for row in rows:
+            require(isinstance(row, dict) and row.get("task") == task, f"{task}: mismatched task")
+            seed = row.get("seed")
+            require(type(seed) is int and seed in SEEDS and seed not in values, f"{task}: invalid/duplicate seed")
+            require(type(row.get("success")) is bool, f"{task}/{seed}: success must be boolean")
+            values[seed] = row["success"]
+            path = root / task / f"episode_seed{seed}.npz"
+            require(path.is_file(), f"missing trace: {path}")
+            with np.load(path, allow_pickle=False) as trace:
+                require("trace" in trace and "success" in trace, f"{path}: missing trace or success")
+                success = trace["success"]
+                require(success.shape == () and success.dtype.kind == "b" and bool(success) == row["success"],
+                        f"{path}: trace outcome mismatch")
+        require(set(values) == SEEDS, f"{task}: incomplete public seed set")
+        outcomes[task] = values
+        summary = read_json(root / task / "summary.json")
+        require(isinstance(summary, dict) and summary.get("task") == task, f"{task}: invalid summary")
+        for field, expected in (("episodes", 50), ("successes", sum(values.values()))):
+            require(type(summary.get(field)) is int and summary[field] == expected, f"{task}: summary {field} mismatch")
+        refs = summary.get("videos", {})
+        require(isinstance(refs, dict) and set(refs) <= {"success", "failure"}, f"{task}: invalid videos")
+        videos[task] = refs
+        for label, filename in refs.items():
+            if filename is None:
+                continue
+            require(isinstance(filename, str), f"{task}: invalid video reference")
+            match = re.fullmatch(rf"{task}_{label}_seed(\d+)\.mp4", filename)
+            require(match is not None, f"{task}: unexpected video name {filename}")
+            seed = int(match[1])
+            require(seed in values and values[seed] == (label == "success"), f"{task}: video outcome mismatch")
+            require((root / task / filename).is_file(), f"{task}: missing video {filename}")
+    details = {}
+    for row in analysis["episodes"]:
+        require(isinstance(row, dict), "invalid classification row")
+        task, seed = row.get("task"), row.get("seed")
+        require(isinstance(task, str) and task in TASKS and type(seed) is int and seed in SEEDS,
+                "classification task/seed invalid")
+        key = (task, seed)
+        require(key not in details and not outcomes[task][seed], f"{key}: duplicate or successful classification")
+        require(row.get("stage") in STAGES and isinstance(row.get("why"), str), f"{key}: invalid stage/reason")
+        if "success" in row:
+            require(type(row["success"]) is bool and not row["success"], f"{key}: classification outcome mismatch")
+        details[key] = row
+    require(set(details) == {(t, s) for t in TASKS for s in SEEDS if not outcomes[t][s]},
+            "classification details must cover exactly all failures")
+    tables = {}
+    for row in analysis["table"]:
+        require(isinstance(row, dict) and isinstance(row.get("task"), str), "invalid table row")
+        task = row["task"]
+        require(task in TASKS and task not in tables, "invalid/duplicate table task")
+        counts = Counter(r["stage"] for (t, _), r in details.items() if t == task)
+        for key, expected in {"episodes": 50, "failures": 50 - sum(outcomes[task].values()),
+                              **{s: counts[s] for s in STAGES}}.items():
+            actual = row.get(key, 0) if key == "unknown" else row.get(key)
+            require(type(actual) is int and actual == expected, f"{task}: table {key} mismatch")
+        require(row.get("videos", {}) == videos[task], f"{task}: table videos mismatch")
+        tables[task] = row
+    require(set(tables) == set(TASKS), "incomplete classification table")
+
+    def stage_report(rows, denominator):
+        counts = Counter(r["stage"] for r in rows)
+        return {s: {"count": counts[s], "incidence_rate": counts[s] / denominator,
+                    "reason_counts": dict(sorted(Counter(r["why"] for r in rows if r["stage"] == s).items()))}
+                for s in STAGES}
+
+    task_reports = []
+    exemplars = []
+    for task in TASKS:
+        rows = [details[task, s] for s in sorted(SEEDS) if (task, s) in details]
+        task_reports.append({"task": task, "episodes": 50, "successes": sum(outcomes[task].values()),
+                             "success_rate": sum(outcomes[task].values()) / 50,
+                             "stages": stage_report(rows, 50)})
+        # Up to two failures per task/stage: prefer the recorded video, then a different reason.
+        for stage in STAGES:
+            candidates = [r for r in rows if r["stage"] == stage]
+            failure_video = videos[task].get("failure")
+            candidates.sort(key=lambda r: (failure_video != f"{task}_failure_seed{r['seed']}.mp4", r["seed"]))
+            selected = candidates[:1]
+            if selected:
+                remaining = candidates[1:]
+                diverse = [r for r in remaining if r["why"] != selected[0]["why"]]
+                selected += (diverse or remaining)[:1]
+            for row in selected:
+                seed = row["seed"]
+                video = failure_video if failure_video == f"{task}_failure_seed{seed}.mp4" else None
+                exemplars.append({**row, "trace_path": str(root / task / f"episode_seed{seed}.npz"),
+                                  "video_path": str(root / task / video) if video else None})
+    rates = [r["success_rate"] for r in task_reports]
+    return {"purpose": "diagnostic, not training", "evaluation_root": str(root),
+            "failure_analysis_path": str(analysis_path), "failure_analysis_sha256": hashlib.sha256(raw).hexdigest(),
+            "episodes": 500, "units": "fraction", "rate_denominator": "all evaluated episodes, not only failures",
+            "baseline": {"macro_mean": statistics.mean(rates), "task_sample_sd": statistics.stdev(rates)},
+            "tasks": task_reports, "stages": stage_report(list(details.values()), 500),
+            "exemplars": exemplars,
+            "limitations": "Stage tags are observable classifier outputs, not causal diagnoses. Inspect traces/videos; unknown is separate. Task SD is not training-seed uncertainty. Public evidence must not become training inputs, value labels, or checkpoint-selection data."}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--eval", type=Path, required=True)
+    parser.add_argument("--failure-analysis", type=Path)
+    args = parser.parse_args()
+    try:
+        result = summarize(args.eval, args.failure_analysis)
+    except (ValueError, OSError, KeyError) as exc:
+        parser.error(str(exc))
+    print(json.dumps(result, indent=2, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/vla_lab/scripts/train_recap_actor.py b/vla_lab/scripts/train_recap_actor.py
new file mode 100644
index 0000000000000000000000000000000000000000..15da9b928e9e1b34c6c004dac63585952e4e3075
--- /dev/null
+++ b/vla_lab/scripts/train_recap_actor.py
@@ -0,0 +1,223 @@
+"""Train either matched post-training actor through pinned LeRobot's stock train loop.
+
+Use the course environment with the CUDA NPP runtime exposed to TorchCodec. The
+mixed corpus, stock B0 checkpoint, update budget, and actor view must be identical
+for B1 and R1. The only treatment is advantage conditioning at training/inference.
+"""
+
+import argparse
+from collections import Counter
+from dataclasses import fields
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+
+from collect_recap_rollouts import policy_identity
+from recap_actor_data import CanonicalActorView, EpisodeSpan
+from recap_processor import configure_pipeline_json
+
+
+TASKS = tuple(f"T{i}" for i in range(1, 11))
+MODEL_FILES = ('model.safetensors', 'config.json', 'policy_preprocessor.json', 'policy_postprocessor.json')
+RENAME = {f'observation.images.{side}': f'observation.images.camera{i}'
+          for i, side in enumerate(('front', 'left', 'right'), 1)}
+
+
+def read_json(path):
+    return json.loads(Path(path).read_text())
+
+
+def sha(path):
+    with Path(path).open('rb') as handle:
+        return hashlib.file_digest(handle, 'sha256').hexdigest()
+
+
+def check_rollout_policy(episodes, base):
+    expected = policy_identity(base)['sha256']
+    revisions = {(e['policy_sha256'], e['n_action_steps']) for e in episodes if e['source'] == 'autonomous'}
+    if revisions != {(expected, 50)}:
+        raise ValueError('The autonomous experience was not collected from this exact B0 policy at 50/50')
+    return expected
+
+
+def read_training_protocol(root, base):
+    manifest = root / 'recap_manifest.json'
+    obj = read_json(manifest)
+    dataset_id = obj['dataset_id']
+    if obj['schema_version'] != 1 or dataset_id != 'local/RBY1-T1-T10-RECAP-MIXED':
+        raise ValueError('Not the verified class RECAP mixed corpus')
+    columns = tuple(f.name for f in fields(EpisodeSpan))
+    spans = tuple(EpisodeSpan(**{k: e[k] for k in columns}) for e in obj['episodes'])
+    counts = Counter((e.source, e.task) for e in spans)
+    if (set(e.task for e in spans) != set(TASKS) or len(spans) > 1000 or
+        any(counts['oracle', t] != 50 or not 20 <= counts['autonomous', t] <= 50 for t in TASKS) or
+        sum(counts[s, t] for t in TASKS for s in ('oracle', 'autonomous')) != len(spans)):
+        raise ValueError('Production actor training requires all ten tasks and the approved counts')
+    return dataset_id, spans, sha(manifest), check_rollout_policy(obj['episodes'], base)
+
+
+def check_labels(dataset_id, spans, manifest_hash, labels_path, report_path):
+    report = read_json(report_path)
+    label_hash = sha(labels_path)
+    if (report.get('viable') is not True or report.get('dataset_id') != dataset_id
+        or report.get('manifest_sha256') != manifest_hash or report.get('labels_sha256') != label_hash):
+        raise ValueError('RECAP requires a passing, hash-bound learned value report')
+    labels = read_json(labels_path)
+    if labels.get('schema_version') != 1 or labels.get('dataset_id') != dataset_id:
+        raise ValueError('Unexpected label schema/dataset')
+    expected = {i: (e.episode_index, e.task_index, e.instruction, e.task, e.source)
+                for e in spans for i in range(e.row_start, e.row_start + e.preterminal_actions)}
+    seen = set()
+    supports = {t: set() for t in TASKS}
+    for row in labels['rows']:
+        i, indicator = row['index'], row['indicator']
+        if (type(i) is not int or i in seen or i not in expected or
+            type(indicator) is not int or indicator not in (0, 1)):
+            raise ValueError('Duplicate/noncanonical actor row or non-binary label')
+        seen.add(i)
+        episode, task_index, instruction, task, source = expected[i]
+        if (row['episode_index'], row['task_index'], row['task']) != (episode, task_index, instruction):
+            raise ValueError(f'Label source identity mismatch at {i}')
+        if source == 'autonomous':
+            supports[task].add(indicator)
+    if len(seen) != len(expected) or any(classes != {0, 1} for classes in supports.values()):
+        raise ValueError('The labels do not cover every actor row or a task lacks a thresholded class')
+    return label_hash
+
+
+def processor_files(*configs):
+    """Only include locally named processor states referenced by exported JSON."""
+    names = set()
+    for config in configs:
+        for step in config['steps']:
+            state = step.get('state_file')
+            if state:
+                if (not isinstance(state, str) or Path(state).name != state or
+                    not state.endswith('.safetensors')):
+                    raise ValueError('Unsafe processor state path')
+                names.add(state)
+    return names
+
+
+def prepare_checkpoint(source, target, mode, label_cfg=None, *, copy_files=False):
+    policy_config = read_json(source / 'config.json')
+    if (policy_config['type'] != 'smolvla' or policy_config['chunk_size'] != 50 or
+        policy_config['n_action_steps'] != 50):
+        raise ValueError('Expected stock SmolVLA chunk/replan 50/50')
+    pre = configure_pipeline_json(read_json(source / 'policy_preprocessor.json'), mode=mode,
+                                  training_config=label_cfg)
+    post = read_json(source / 'policy_postprocessor.json')
+    target.mkdir()
+    for name in ('model.safetensors', 'config.json', *sorted(processor_files(pre, post))):
+        src = source / name
+        if not src.is_file():
+            raise FileNotFoundError(src)
+        if copy_files:
+            shutil.copyfile(src, target / name)
+        else:
+            (target / name).symlink_to(src.resolve())
+    (target / 'policy_preprocessor.json').write_text(json.dumps(pre, indent=2))
+    (target / 'policy_postprocessor.json').write_text(json.dumps(post, indent=2))
+
+
+def run(a):
+    import torch
+    from lerobot.scripts import lerobot_train
+
+    dataset = a.dataset.resolve(strict=True)
+    base = a.base.resolve(strict=True)
+    output = a.output.resolve()
+    if output.exists():
+        raise FileExistsError(f'Choose a new output, incomplete runs are never overwritten: {output}')
+    if base.parent.resolve().name != '025000':
+        raise ValueError('Expected the final 25,000-update B0 policy from the original protocol')
+    if not 0 < a.warmup < a.steps or a.lr <= 0:
+        raise ValueError('Specify a positive LR and warmup shorter than the shared update budget')
+    dataset_id, spans, manifest_hash, rollout_policy_sha = read_training_protocol(dataset, base)
+    label_config = None
+    if a.arm == 'R1':
+        if not a.labels or not a.value_report:
+            raise ValueError('R1 requires both value labels and the successful fit report')
+        labels = a.labels.resolve(strict=True)
+        label_hash = check_labels(dataset_id, spans, manifest_hash, labels, a.value_report)
+        label_config = dict(labels_path=str(labels), dataset_id=dataset_id, labels_sha256=label_hash,
+                            dropout_probability=.3, seed=1000)
+    elif a.labels or a.value_report:
+        raise ValueError('B1 cannot read any advantage labels or value outcomes')
+
+    if torch.cuda.device_count() != 1:
+        raise RuntimeError('Use a single visible GPU for the two matched actor runs')
+    total = torch.cuda.get_device_properties(0).total_memory
+    torch.cuda.set_per_process_memory_fraction(min(1.0, 7 * 1024**3 / total), 0)
+    print('ACTOR_VRAM_CAP 7.0 GiB torch allocation; monitor nvidia-smi separately', flush=True)
+    output.parent.mkdir(parents=True, exist_ok=True)
+
+    stock_make = lerobot_train.make_dataset
+    stock_args = sys.argv[:]
+    with tempfile.TemporaryDirectory(prefix='.recap-init-', dir=output.parent) as temp:
+        init = Path(temp) / 'pretrained_model'
+        mode = 'train' if label_config else 'unconditional'
+        prepare_checkpoint(base, init, mode, label_config)
+
+        def make_canonical(cfg):
+            if (cfg.policy.type != 'smolvla' or hasattr(cfg.policy, 'drop_n_last_frames') or
+                cfg.dataset.episodes is not None or cfg.dataset.repo_id != dataset_id or
+                Path(cfg.dataset.root).resolve() != dataset):
+                raise ValueError('Expected unfiltered SmolVLA with canonical shuffled sampling')
+            return CanonicalActorView(stock_make(cfg), spans, chunk_size=50)
+
+        os.environ.update(HF_HUB_OFFLINE='1', WANDB_MODE='disabled')
+        lerobot_train.make_dataset = make_canonical
+        sys.argv = ['lerobot-train', f'--policy.path={init}', '--policy.device=cuda',
+                    '--policy.push_to_hub=false', f'--policy.optimizer_lr={a.lr}',
+                    f'--policy.scheduler_warmup_steps={a.warmup}', f'--policy.scheduler_decay_steps={a.steps}',
+                    f'--dataset.repo_id={dataset_id}', f'--dataset.root={dataset}',
+                    f'--rename_map={json.dumps(RENAME)}', '--batch_size=16', '--num_workers=4',
+                    '--seed=1000', '--wandb.enable=false', '--log_freq=100',
+                    f'--steps={a.steps}', f'--save_freq={a.steps}', f'--output_dir={output}']
+        try:
+            lerobot_train.main()
+        finally:
+            lerobot_train.make_dataset = stock_make
+            sys.argv = stock_args
+
+    last = (output / 'checkpoints/last').resolve(strict=True)
+    if int(last.name) != a.steps:
+        raise RuntimeError('The fixed last-update checkpoint was not saved')
+    deploy = output / 'deploy'
+    deploy.mkdir()
+    prepare_checkpoint(last / 'pretrained_model', deploy / 'pretrained_model',
+                       'deploy' if label_config else 'unconditional', copy_files=True)
+    run_record = dict(arm=a.arm, dataset_id=dataset_id, manifest_sha256=manifest_hash,
+                      rollout_policy_sha256=rollout_policy_sha,
+                      base_sha256={name: sha(base / name) for name in MODEL_FILES},
+                      steps=a.steps, batch_size=16, lr=a.lr, warmup=a.warmup,
+                      seed=1000, chunk_size=50, n_action_steps=50,
+                      canonical_actor_frames=sum(e.preterminal_actions for e in spans),
+                      vram_reserved_mib=torch.cuda.max_memory_reserved() // 1024**2,
+                      labels_sha256=label_config['labels_sha256'] if label_config else None,
+                      model_sha256=sha(deploy / 'pretrained_model/model.safetensors'))
+    (output / 'actor_run.json').write_text(json.dumps(run_record, indent=2))
+    print('ACTOR_TRAIN_PASS', a.arm, deploy / 'pretrained_model', flush=True)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--arm', choices=['B1', 'R1'], required=True)
+    p.add_argument('--base', type=Path, required=True, help='B0 last/pretrained_model')
+    p.add_argument('--dataset', type=Path, required=True, help='Verified mixed LeRobot v3 root')
+    p.add_argument('--output', type=Path, required=True)
+    p.add_argument('--steps', type=int, default=5000)
+    p.add_argument('--warmup', type=int, default=200)
+    p.add_argument('--lr', type=float, default=2e-5)
+    p.add_argument('--labels', type=Path, help='R1 only')
+    p.add_argument('--value-report', type=Path, help='R1 only')
+    run(p.parse_args())
+
+
+if __name__ == '__main__':
+    main()
