@@ -0,0 +1,63 @@
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+spec = importlib.util.spec_from_file_location('pixels', Path(__file__).parents[1] / 'scripts/archive_oracle_pixels.py')
+pixels = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(pixels)
+FFMPEG = os.environ.get('FFMPEG', shutil.which('ffmpeg'))
+
+@unittest.skipUnless(FFMPEG, 'ffmpeg unavailable')
+class PixelsTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.ep = self.root / 'episode'
+        self.ep.mkdir()
+        (self.ep / 'camera').mkdir()
+        (self.ep / 'episode.json').write_text(json.dumps({'status':'saved','frames':3,'cameras':['camera'],'camera_sizes':{'camera':[8,8]}}))
+        subprocess.run([FFMPEG,'-v','error','-f','lavfi','-i','testsrc=size=8x8:rate=15','-frames:v','3','-threads','1','-start_number','0',str(self.ep/'camera/%06d.png')],check=True)
+        self.arc = self.root / 'archive'
+    def tearDown(self):
+        self.tmp.cleanup()
+    def test_round_trip(self):
+        pixels.archive(self.ep,self.arc,FFMPEG)
+        pixels.prune(self.ep,self.arc,FFMPEG)
+        self.assertFalse((self.ep/'camera').exists())
+        pixels.restore(self.ep,self.arc,FFMPEG)
+        pixels.verify(self.ep,self.arc,FFMPEG)
+        self.assertEqual(len(list((self.ep/'camera').glob('*.png'))),3)
+    def test_x264rgb_roundtrip_and_restored_verification(self):
+        manifest = pixels.archive(self.ep, self.arc, FFMPEG, codec='x264rgb')
+        self.assertEqual(manifest['codec'], 'x264rgb')
+        pixels.prune(self.ep, self.arc, FFMPEG)
+        pixels.restore(self.ep, self.arc, FFMPEG)
+        pixels.verify(self.ep, self.arc, FFMPEG)
+        # A valid PNG with wrong pixels must fail source verification.
+        shutil.copyfile(self.ep/'camera/000002.png', self.ep/'camera/000000.png')
+        with self.assertRaises(ValueError): pixels.verify(self.ep, self.arc, FFMPEG)
+    def test_incomplete(self):
+        (self.ep/'camera/000001.png').unlink()
+        with self.assertRaises(ValueError): pixels.archive(self.ep,self.arc,FFMPEG)
+        self.assertFalse(self.arc.exists())
+        self.assertTrue((self.ep/'camera/000000.png').exists())
+    def test_corrupt_prune_preserves_sources(self):
+        pixels.archive(self.ep,self.arc,FFMPEG)
+        (self.arc/'camera.mkv').write_bytes(b'broken')
+        with self.assertRaises(ValueError): pixels.prune(self.ep,self.arc,FFMPEG)
+        self.assertEqual(len(list((self.ep/'camera').glob('*.png'))),3)
+    def test_refuse_overwrite(self):
+        pixels.archive(self.ep,self.arc,FFMPEG)
+        with self.assertRaises(FileExistsError): pixels.archive(self.ep,self.arc,FFMPEG)
+        with self.assertRaises(FileExistsError): pixels.restore(self.ep,self.arc,FFMPEG)
+    def test_encoder_failure_preserves_sources(self):
+        with self.assertRaises(OSError): pixels.archive(self.ep,self.arc,'/does/not/exist')
+        self.assertFalse(self.arc.exists())
+        self.assertEqual(len(list((self.ep/'camera').glob('*.png'))),3)
+
+if __name__ == '__main__': unittest.main()
