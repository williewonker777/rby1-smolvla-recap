+    shapes = {key: (32, 32) for key in ("front", "right", "left")}
+    features = {key: {"dtype": "float32", "shape": (16,), "names": [str(i) for i in range(16)]}
+                for key in ("action", "observation.state")}
+    features.update({f"observation.images.{key}": {"dtype": "video", "shape": (*shape, 3),
+                     "names": ["height", "width", "channels"]} for key, shape in shapes.items()})
+    root = tmp_path / "dataset"
+    ds = dataset_module.LeRobotDataset.create(repo_id="local/recap-collector-test", root=root,
+         fps=15, features=features, robot_type="rby1", video_backend="pyav",
+         vcodec="libsvtav1", image_writer_threads=3)
+    states = [np.arange(16, dtype=np.float32) + i for i in range(2)]
+    actions = [state / 10 for state in states]
+    try:
+        for state, action in zip(states, actions):
+            ds.add_frame({"task": "cpu test", "observation.state": state, "action": action,
+                **{f"observation.images.{key}": np.zeros((*shape, 3), dtype=np.uint8) for key, shape in shapes.items()}})
+        ds.save_episode(parallel_encoding=False)
+        ds.finalize()
+        collector.validate_saved_dataset(root, states, actions, shapes)
+        assert not list(root.rglob("*.png"))
+        # Final atomic rename must preserve all episode/video index lookups.
+        renamed = tmp_path / "published"
+        root.rename(renamed)
+        collector.validate_saved_dataset(renamed, states, actions, shapes)
+        with pytest.raises(ValueError, match="numeric mismatch"):
+            collector.validate_saved_dataset(renamed, states, [a + 1 for a in actions], shapes)
+    finally:
+        ds.stop_image_writer()
