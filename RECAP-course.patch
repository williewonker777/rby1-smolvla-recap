+"""CPU-only regressions; optional RECAP_STOCK_CHECKPOINT enables cached smoke."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import random
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+import torch
+
+SCRIPTS = Path(__file__).resolve().parents[1] / 'scripts'
+sys.path.insert(0, str(SCRIPTS))
+from recap_processor import (ActionPaddingBridgeStep, PositiveAdvantageStep,
+                             TrainingAdvantageStep, configure_pipeline_json)
+from lerobot.processor import PolicyProcessorPipeline
