+        self.assertEqual(len(result["exemplars"]), 20)
+        self.assertTrue(result["exemplars"][0]["video_path"].endswith('T1_failure_seed100001.mp4'))
+        self.assertEqual(result, module.summarize(self.root))
+        after = {p: hashlib.sha256(p.read_bytes()).hexdigest() for p in self.root.rglob('*') if p.is_file()}
+        self.assertEqual(before, after)
