+import importlib.util
+import os
+from pathlib import Path
+import sys
+from dataclasses import replace
+from types import SimpleNamespace
+import unittest
+
+import pandas as pd
+import torch
+from datasets import Dataset
+
+SPEC = importlib.util.spec_from_file_location('recap_actor_data', Path(__file__).parents[1] / 'scripts/recap_actor_data.py')
+m = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = m
+SPEC.loader.exec_module(m)
+
+
+class FakeDataset:
+    def __init__(self):
+        self.episodes = None
+        self.delta_indices = {'action': list(range(4))}
+        self.meta = SimpleNamespace(total_frames=7, total_episodes=2,
+                                    episodes=[dict(dataset_from_index=0, dataset_to_index=4, length=4),
+                                              dict(dataset_from_index=4, dataset_to_index=7, length=3)],
+                                    tasks=pd.DataFrame({'task_index': [0, 1]}, index=['first', 'second']))
+        self.hf_dataset = Dataset.from_dict(dict(index=list(range(7)), frame_index=[0, 1, 2, 3, 0, 1, 2],
+                                                episode_index=[0]*4+[1]*3, task_index=[0]*4+[1]*3))
+        self.hf_dataset.set_format('torch')
+        self.calls = []
+        self.corrupt = {}
+        self.features, self.fps, self.root, self.repo_id = {}, 15, Path('/synthetic'), 'synthetic'
+
+    def _ensure_hf_dataset_loaded(self):
+        pass
+
+    def __len__(self):
+        return 7
+
+    def __getitem__(self, index):
+        self.calls.append(index)
+        item = self.hf_dataset[index]
+        end = 4 if index < 4 else 7
+        item.update(task='first' if index < 4 else 'second',
+                    action=torch.tensor([[float(min(j, end-1))]*16 for j in range(index, index+4)]),
+                    action_is_pad=torch.tensor([j >= end for j in range(index, index+4)]))
+        item.update(self.corrupt)
+        return item
+
+
+def spans():
+    return [m.EpisodeSpan(0, 0, 4, 2, 'T1', 0, 'first', 'oracle', 0),
+            m.EpisodeSpan(1, 4, 3, 3, 'T2', 1, 'second', 'autonomous', 4000)]
+
+
+class ActorDataTests(unittest.TestCase):
+    def test_absolute_indices_and_terminal_scrubbing(self):
+        base = FakeDataset()
+        view = m.CanonicalActorView(base, spans(), chunk_size=4)
+        self.assertEqual(view.absolute_indices, (0, 1, 4, 5, 6))
+        self.assertEqual(view.canonical_episode_ranges, ((0, 2), (2, 5)))
+        self.assertEqual((len(view), view.num_frames, view.num_episodes), (5, 5, 2))
+        self.assertIs(view.meta, base.meta)
+        self.assertEqual(view.meta.total_frames, 7)
+        self.assertEqual(base.calls, [])  # Construction never decodes video.
+        item = view[1]
+        self.assertEqual(item['index'], 1)
+        self.assertTrue(torch.equal(item['action_is_pad'], torch.tensor([False, True, True, True])))
+        self.assertTrue(torch.equal(item['action'], torch.ones(4, 16)))
+        item2 = view[2]
+        self.assertEqual(item2['index'], 4)
+        self.assertEqual(item2['frame_index'], 0)
+        last = view[4]
+        self.assertEqual(last['index'], 6)
+        self.assertTrue(torch.equal(last['action'], torch.full((4, 16), 6.)))
+        self.assertEqual(base.calls, [1, 4, 6])
+        self.assertEqual(base[1]['action'][1, 0], 2)  # Underlying data unchanged.
+        batch = next(iter(torch.utils.data.DataLoader(view, batch_size=5)))
+        self.assertEqual(tuple(batch['action_is_pad'].shape), (5, 4))
+        self.assertEqual(batch['index'].tolist(), [0, 1, 4, 5, 6])
+        processor_spec = importlib.util.spec_from_file_location(
+            'recap_processor', Path(__file__).parents[1] / 'scripts/recap_processor.py')
+        processor = importlib.util.module_from_spec(processor_spec)
+        processor_spec.loader.exec_module(processor)
+        bridged = processor.ActionPaddingBridgeStep().complementary_data(batch)
+        self.assertTrue(torch.equal(bridged['actions_id_pad'], batch['action_is_pad']))
+
+    def test_autonomous_terminal_is_external_not_an_actor_row(self):
+        view = m.CanonicalActorView(FakeDataset(), spans(), 4)
+        autonomous = spans()[1]
+        self.assertEqual(autonomous.row_count, autonomous.preterminal_actions)
+        self.assertEqual(view.absolute_indices[2:], (4, 5, 6))
+        last = view[4]
+        self.assertTrue(torch.equal(last['action_is_pad'], torch.tensor([False, True, True, True])))
+        self.assertNotIn(autonomous.row_start + autonomous.preterminal_actions, view.absolute_indices)
+        with self.assertRaises(IndexError):
+            view[5]
+        # Reject the obsolete T+1 layout, even when its physical metadata agrees.
+        base = FakeDataset()
+        with self.assertRaisesRegex(ValueError, 'exactly T actor rows'):
+            m.CanonicalActorView(base, [spans()[0], replace(autonomous, preterminal_actions=2)], 4)
+
+    def test_bad_spans(self):
+        for field, value in [('row_start', 1), ('episode_index', 1), ('row_count', 3),
+                             ('preterminal_actions', 0), ('preterminal_actions', 4),
+                             ('seed', 100000), ('seed', True), ('source', 'correction'),
+                             ('task', 'T11'), ('instruction', 'wrong'), ('task_index', 1)]:
+            with self.subTest(field=field), self.assertRaises(ValueError):
+                m.CanonicalActorView(FakeDataset(), [replace(spans()[0], **{field: value}), spans()[1]], 4)
+        with self.assertRaises(ValueError):
+            m.CanonicalActorView(FakeDataset(), [spans()[0]], 4)
+        with self.assertRaises(ValueError):
+            m.CanonicalActorView(FakeDataset(), [spans()[0], replace(spans()[1], preterminal_actions=2)], 4)
+        with self.assertRaises(ValueError):
+            m.CanonicalActorView(FakeDataset(), [spans()[0], replace(spans()[1], task='T1', seed=0, source='oracle')], 4)
+
+    def test_reject_subset_and_misaligned_source(self):
+        for mutate in [lambda d: setattr(d, 'episodes', [0]),
+                       lambda d: setattr(d, 'delta_indices', {'action': [0, 2, 4, 6]}),
+                       lambda d: setattr(d, 'hf_dataset', d.hf_dataset.select(list(reversed(range(7))))),
+                       lambda d: d.meta.episodes[0].update(length=3)]:
+            base = FakeDataset()
+            mutate(base)
+            with self.assertRaises(ValueError):
+                m.CanonicalActorView(base, spans(), 4)
+
+    def test_getitem_identity_and_padding_rejections(self):
+        base = FakeDataset()
+        view = m.CanonicalActorView(base, spans(), 4)
+        for invalid in [-1, 5]:
+            with self.assertRaises(IndexError):
+                view[invalid]
+        for invalid in [True, slice(0, 1), [0], torch.tensor(0)]:
+            with self.assertRaises(TypeError):
+                view[invalid]
+        for changes in [dict(index=torch.tensor(2)), dict(episode_index=1), dict(frame_index=1),
+                        dict(task_index=1), dict(task='bad'), dict(action_is_pad=torch.zeros(4)),
+                        dict(action_is_pad=torch.ones(4, dtype=torch.bool)),
+                        dict(action=torch.full((4, 16), float('nan'))), dict(actions_id_pad=torch.zeros(4))]:
+            base.corrupt = changes
+            with self.subTest(changes=changes), self.assertRaises(ValueError):
+                view[0]
+
+    @unittest.skipUnless(os.environ.get('RECAP_ACTOR_SMOKE_ROOT'), 'set RECAP_ACTOR_SMOKE_ROOT for real T1')
+    def test_real_t1_dataset(self):
+        from lerobot.datasets.lerobot_dataset import LeRobotDataset
+        dataset = LeRobotDataset('local/task387-smoke', root=os.environ['RECAP_ACTOR_SMOKE_ROOT'],
+                                 delta_timestamps={'action': [i/15 for i in range(50)]},
+                                 video_backend='torchcodec')
+        instruction = dataset.meta.tasks.iloc[0].name
+        view = m.CanonicalActorView(dataset, [m.EpisodeSpan(0, 0, 258, 257, 'T1', 0, instruction, 'oracle', 0)])
+        self.assertEqual(len(view), 257)
+        item = view[256]
+        self.assertEqual(item['index'].item(), 256)
+        self.assertEqual(item['frame_index'].item(), 256)
+        self.assertFalse(item['action_is_pad'][0])
+        self.assertTrue(item['action_is_pad'][1:].all())
+        self.assertTrue(torch.equal(item['action'], item['action'][0].expand(50, -1)))
+        self.assertTrue(torch.equal(item['action'][0], dataset.hf_dataset[256]['action']))
+        self.assertNotIn(257, view.absolute_indices)
+        with self.assertRaises(IndexError):
+            view[257]
+
+
+if __name__ == '__main__':
+    unittest.main()
