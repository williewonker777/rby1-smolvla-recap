+++ b/vla_lab/scripts/recap_processor.py
@@ -0,0 +1,224 @@
+"""Checkpoint-portable RECAP text conditioning for pinned LeRobot v0.4.3.
+
+Launcher contract:
+* Write the strict JSON labels schema documented in TrainingAdvantageStep and pin
+  its SHA256. Labels refer to exported dataset indices, never loader order.
+* Call configure_pipeline_json(stock_json, mode='train', training_config=...) for
+  the conditional arm and mode='unconditional' for the matched control. Both get
+  the same action padding bridge. Load using the stock processor loader.
+* Export conditional checkpoints with mode='deploy', then reload/validate them.
+  This removes the training step/config/state reference entirely; deployment
+  never needs the sidecar. Keep referenced stock normalizer state files intact.
+* Save the training pipeline separately for exact dropout RNG resume. Merely
+  rebuilding from get_config restarts the RNG; loading saved state resumes it.
+
+These classes deliberately have no registry decorators. Keep this module on
+PYTHONPATH when loading checkpoints with the unmodified evaluation launcher.
+"""
+
+import copy
+import hashlib
+import json
+import math
+import random
+from pathlib import Path
+
+import torch
+from lerobot.processor import ComplementaryDataProcessorStep
+
+
+def _integer(value, name):
+    if type(value) is not int or value < 0:
+        raise ValueError(f'{name} must be a nonnegative integer')
+    return value
+
+
+def _tasks(data):
+    tasks = data.get('task')
+    scalar = isinstance(tasks, str)
+    values = [tasks] if scalar else tasks
+    if not isinstance(values, list) or not values or any(
+        not isinstance(t, str) or not t.strip() or '\nAdvantage:' in t for t in values
+    ):
+        raise ValueError('task must contain nonempty, unconditioned strings')
+    return values, scalar
+
+
+def _indices(data, key, size):
+    values = data.get(key)
+    if isinstance(values, torch.Tensor):
+        if values.dtype not in (torch.int8, torch.int16, torch.int32, torch.int64, torch.uint8):
+            raise ValueError(f'{key} must have integer dtype')
+        values = values.detach().cpu().tolist()
+    if type(values) is int:
+        values = [values]
+    if not isinstance(values, list) or len(values) != size:
+        raise ValueError(f'{key} must have one integer per task')
+    return [_integer(v, key) for v in values]
+
+
+class _ComplementaryStep(ComplementaryDataProcessorStep):
+    def transform_features(self, features):
+        return features
+
+
+class ActionPaddingBridgeStep(_ComplementaryStep):
+    """Forward official padding flags to the stock SmolVLA loss's typo key."""
+
+    def complementary_data(self, complementary_data):
+        data = dict(complementary_data)
+        mask = data.get('action_is_pad')
+        if mask is None:
+            if 'actions_id_pad' in data:
+                raise ValueError('actions_id_pad without authoritative action_is_pad')
+            return data  # Deployment contains no action targets.
+        if not isinstance(mask, torch.Tensor) or mask.dtype != torch.bool or mask.ndim != 2:
+            raise ValueError('action_is_pad must be a [batch, chunk] bool tensor')
+        previous = data.get('actions_id_pad')
+        if previous is not None and (not isinstance(previous, torch.Tensor) or
+                                     previous.dtype != torch.bool or not torch.equal(previous, mask)):
+            raise ValueError('conflicting actions_id_pad')
+        data['actions_id_pad'] = mask
+        return data
+
+
+class PositiveAdvantageStep(_ComplementaryStep):
+    """Deployment-only conditioning: always positive, no labels or RNG."""
+
+    def complementary_data(self, complementary_data):
+        data = dict(complementary_data)
+        tasks, scalar = _tasks(data)
+        result = [f'{task}\nAdvantage: positive' for task in tasks]
+        data['task'] = result[0] if scalar else result
+        return data
+
+
+class TrainingAdvantageStep(_ComplementaryStep):
+    """Join truthful binary labels and independently drop conditioning per sample.
+
+    JSON: {"schema_version":1,"dataset_id":"...","rows":[
+      {"index":0,"episode_index":0,"task_index":0,"task":"...","indicator":1}]}
+    All fields are required/exact; index is unique. Every minibatch must provide
+    index, episode_index, task_index and exact original task text. The launcher
+    must additionally check sidecar coverage against its complete dataset.
+    """
+
+    def __init__(self, labels_path, dataset_id, labels_sha256,
+                 dropout_probability=0.3, seed=1000):
+        if not isinstance(dataset_id, str) or not dataset_id:
+            raise ValueError('dataset_id must be nonempty')
+        if not isinstance(labels_sha256, str) or len(labels_sha256) != 64:
+            raise ValueError('labels_sha256 must be a SHA256 hex digest')
+        if isinstance(dropout_probability, bool) or not isinstance(dropout_probability, (float, int)) or not math.isfinite(dropout_probability) or not 0 <= dropout_probability <= 1:
+            raise ValueError('dropout_probability must be in [0,1]')
+        _integer(seed, 'seed')
+        raw = Path(labels_path).read_bytes()
+        if hashlib.sha256(raw).hexdigest() != labels_sha256:
+            raise ValueError('labels sidecar SHA256 mismatch')
+        document = json.loads(raw, object_pairs_hook=_unique_object)
+        if not isinstance(document, dict) or set(document) != {'schema_version', 'dataset_id', 'rows'} or type(document['schema_version']) is not int or document['schema_version'] != 1 or document['dataset_id'] != dataset_id:
+            raise ValueError('invalid labels schema or dataset identity')
+        rows = document['rows']
+        if not isinstance(rows, list) or not rows:
+            raise ValueError('labels rows must be nonempty')
+        self.labels = {}
+        episodes = {}
+        task_texts = {}
+        for row in rows:
+            if not isinstance(row, dict) or set(row) != {'index', 'episode_index', 'task_index', 'task', 'indicator'}:
+                raise ValueError('invalid label row fields')
+            for field in ('index', 'episode_index', 'task_index', 'indicator'):
+                _integer(row[field], field)
+            _tasks({'task': row['task']})
+            if not isinstance(row['task'], str) or row['indicator'] not in (0, 1) or row['index'] in self.labels:
+                raise ValueError('duplicate index or invalid task/indicator')
+            task_id, episode_id = row['task_index'], row['episode_index']
+            if task_id in task_texts and task_texts[task_id] != row['task']:
+                raise ValueError('inconsistent task text')
+            if episode_id in episodes and episodes[episode_id] != task_id:
+                raise ValueError('episode spans multiple tasks')
+            task_texts[task_id] = row['task']
+            episodes[episode_id] = task_id
+            self.labels[row['index']] = row
+        self.labels_path = str(labels_path)
+        self.dataset_id = dataset_id
+        self.labels_sha256 = labels_sha256
+        self.dropout_probability = float(dropout_probability)
+        self.seed = seed
+        self._rng = random.Random(seed)
+
+    def get_config(self):
+        return {key: getattr(self, key) for key in (
+            'labels_path', 'dataset_id', 'labels_sha256', 'dropout_probability', 'seed')}
+
+    def state_dict(self):
+        return {'rng_state': torch.tensor(list(json.dumps(self._rng.getstate()).encode()), dtype=torch.uint8)}
+
+    def load_state_dict(self, state):
+        if set(state) != {'rng_state'}:
+            raise ValueError('missing or unexpected dropout RNG state')
+        value = state['rng_state']
+        if value.dtype != torch.uint8 or value.ndim != 1:
+            raise ValueError('invalid dropout RNG state tensor')
+        version, internal, gaussian = json.loads(bytes(value.cpu().tolist()))
+        self._rng.setstate((version, tuple(internal), gaussian))
+
+    def complementary_data(self, complementary_data):
+        data = dict(complementary_data)
+        tasks, scalar = _tasks(data)
+        indices = {key: _indices(data, key, len(tasks)) for key in ('index', 'episode_index', 'task_index')}
+        labels = []
+        for position, task in enumerate(tasks):
+            row = self.labels.get(indices['index'][position])
+            if row is None or any(row[key] != indices[key][position] for key in indices) or row['task'] != task:
+                raise ValueError('batch index/episode/task does not match pinned labels')
+            labels.append(row['indicator'])
+        result = [task if self._rng.random() < self.dropout_probability else
+                  f"{task}\nAdvantage: {'positive' if label else 'negative'}"
+                  for task, label in zip(tasks, labels, strict=True)]
+        data['task'] = result[0] if scalar else result
+        return data
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f'duplicate JSON key: {key}')
+        result[key] = value
+    return result
+
+
+def configure_pipeline_json(config, *, mode, training_config=None):
+    """Return a copied processor JSON document; never edit state files in place.
+
+    mode: train / deploy / unconditional. Removes previous RECAP steps before
+    insertion, making train→deploy export explicit and idempotent. Other steps,
+    normalizer state filenames, and pipeline name are preserved byte-for-value.
+    """
+    if mode not in ('train', 'deploy', 'unconditional'):
+        raise ValueError('unknown RECAP pipeline mode')
+    if (mode == 'train') != (training_config is not None):
+        raise ValueError('training_config is required only in train mode')
+    result = copy.deepcopy(config)
+    custom = {'recap_processor.' + name for name in (
+        'ActionPaddingBridgeStep', 'TrainingAdvantageStep', 'PositiveAdvantageStep')}
+    steps = [step for step in result['steps'] if step.get('class') not in custom]
+    tokenizers = [i for i, step in enumerate(steps) if step.get('registry_name') == 'tokenizer_processor']
+    if len(tokenizers) != 1:
+        raise ValueError('expected exactly one stock tokenizer')
+    index = tokenizers[0]
+    newlines = [i for i, step in enumerate(steps) if step.get('registry_name') == 'smolvla_new_line_processor']
+    if newlines:
+        if len(newlines) != 1 or newlines[0] > index:
+            raise ValueError('unexpected newline/tokenizer ordering')
+        index = newlines[0]
+    injected = [{'class': 'recap_processor.ActionPaddingBridgeStep', 'config': {}}]
+    if mode == 'train':
+        # Validate schema/pin immediately, before producing a runnable config.
+        training = TrainingAdvantageStep(**training_config)
+        injected.append({'class': 'recap_processor.TrainingAdvantageStep', 'config': training.get_config()})
+    elif mode == 'deploy':
+        injected.append({'class': 'recap_processor.PositiveAdvantageStep', 'config': {}})
+    result['steps'] = steps[:index] + injected + steps[index:]
+    return result
