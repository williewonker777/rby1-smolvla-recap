+"""CPU-only execution/terminal contracts; no Isaac Sim or policy downloads."""
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+MODULE = Path(__file__).resolve().parents[1] / "scripts/collect_recap_rollouts.py"
+spec = importlib.util.spec_from_file_location("collect_recap_rollouts", MODULE)
+collector = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(collector)
+
+
+class Environment:
+    def __init__(self, succeeds_after=None):
+        self.applied = []
+        self.checks = 0
+        self.succeeds_after = succeeds_after
+        self.target = np.zeros(18)
+        self.grip_open = {}
+        self.success = SimpleNamespace(success_original=False, update=self.update)
+
+    def update(self):
+        self.checks += 1
+        self.success.success_original = self.succeeds_after is not None and len(self.applied) >= self.succeeds_after
+
+    def finger_step(self):
+        self.target[14:] = [.01 if self.grip_open['right'] else -.01,
+                            .01 if self.grip_open['left'] else -.01, 0., 0.]
+
+    def apply(self, target):
+        self.applied.append(target.copy())
+
+
+def run(env, horizon=4, action=None):
+    observations, records = [], []
+    if action is None:
+        action = np.r_[np.arange(14), .5, .50001].astype(np.float32)
+
+    def observe():
+        observations.append(len(env.applied))
+        return {"t": len(env.applied)}
+
+    outcome, terminal = collector.rollout(env, horizon, observe, lambda obs: action,
+        lambda t, obs, act, target: records.append((t, obs, act, target)), list(range(14)))
+    return outcome, terminal, observations, records
+
+
+def test_success_checks_before_action_no_terminal_action():
+    env = Environment(succeeds_after=2)
+    outcome, terminal, observations, records = run(env)
+    assert outcome == {"success_original": True, "executed_actions": 2, "official_steps": 3,
+                       "terminal_observation_index": 2, "termination": "success_original"}
+    assert observations == [0, 1, 2]
+    assert terminal == {"t": 2}
+    assert [r[:2] for r in records] == [(0, {"t": 0}), (1, {"t": 1})]
+    assert env.checks == 3
+    assert env.grip_open == {"right": False, "left": True}
+    np.testing.assert_array_equal(records[0][2][:14], np.arange(14))
+    np.testing.assert_array_equal(records[0][3], env.applied[0])
+    assert records[0][2][14] == .5  # log actual policy, not rounded gripper target
+
+
+def test_failure_preserved_and_endpoint_not_relabelled():
+    env = Environment(succeeds_after=4)
+    outcome, terminal, observations, records = run(env)
+    assert outcome["success_original"] is False
+    assert outcome["termination"] == "horizon"
+    assert outcome["executed_actions"] == outcome["official_steps"] == 4
+    assert env.checks == 4
+    assert terminal == {"t": 4}
+    assert observations == list(range(5))
+    assert len(records) == len(env.applied) == 4
+
+
+def test_initial_success_is_zero_action_not_fabricated():
+    outcome, terminal, _, records = run(Environment(succeeds_after=0))
+    assert outcome["executed_actions"] == 0
+    assert outcome["success_original"]
+    assert terminal == {"t": 0}
+    assert records == []
