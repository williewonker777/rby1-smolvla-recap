@@ -0,0 +1,197 @@
+"""Compare complete official RB-Y1 public evaluations; rates are fractions.
+
+python vla_lab/scripts/recap_compare.py --baseline BASE --candidate RECAP
+The bootstrap conditions on the ten tasks and fitted models, not training seeds.
+It does not measure simulator repeatability or prove that training was controlled.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import random
+import statistics
+
+TASKS = tuple(f"T{i}" for i in range(1, 11))
+SEEDS = frozenset(range(100000, 100050))
+TARGET_STAGES = ("approach", "grasp", "transport", "place", "timeout")
+STAGES = TARGET_STAGES + ("unknown",)
+STATES = ("success",) + STAGES
+
+
+def load_results(root):
+    root = Path(root)
+    expected = {root / task / "episodes.json" for task in TASKS}
+    actual = set(root.glob("*/episodes.json"))
+    if actual != expected:
+        raise ValueError(f"{root}: require exactly T1..T10 episode files")
+    result = {}
+    for task in TASKS:
+        rows = json.loads((root / task / "episodes.json").read_text())
+        if not isinstance(rows, list):
+            raise ValueError(f"{task}: episodes must be a list")
+        values = {}
+        for row in rows:
+            if not isinstance(row, dict) or row.get("task") != task:
+                raise ValueError(f"{task}: invalid or mismatched task row")
+            seed = row.get("seed")
+            if type(seed) is not int or seed not in SEEDS or seed in values:
+                raise ValueError(f"{task}: invalid, extra or duplicate seed {seed}")
+            if type(row.get("success")) is not bool:
+                raise ValueError(f"{task}/{seed}: success must be boolean")
+            values[seed] = row["success"]
+        if set(values) != SEEDS:
+            raise ValueError(f"{task}: incomplete public seed set")
+        result[task] = values
+    return result
+
+
+def percentile(sorted_values, fraction):
+    position = (len(sorted_values) - 1) * fraction
+    lower = int(position)
+    upper = min(lower + 1, len(sorted_values) - 1)
+    return sorted_values[lower] + (position - lower) * (sorted_values[upper] - sorted_values[lower])
+
+
+def load_stages(root, outcomes):
+    """Bind official classifier details and aggregate counts to verified outcomes."""
+    path = Path(root) / "failure_analysis.json"
+    raw = path.read_bytes()
+    data = json.loads(raw)
+    if not isinstance(data, dict) or not isinstance(data.get("episodes"), list) or not isinstance(data.get("table"), list):
+        raise ValueError(f"{path}: require classifier episodes and table lists")
+    labels = {task: {seed: "success" for seed, success in outcomes[task].items() if success} for task in TASKS}
+    for row in data["episodes"]:
+        if not isinstance(row, dict):
+            raise ValueError(f"{path}: invalid classification row")
+        task, seed, stage = row.get("task"), row.get("seed"), row.get("stage")
+        if not isinstance(task, str) or task not in TASKS or type(seed) is not int or seed not in SEEDS:
+            raise ValueError(f"{path}: invalid classification task/seed")
+        if seed in labels[task]:
+            raise ValueError(f"{path}: duplicate or successful classification {task}/{seed}")
+        if stage not in STAGES or not isinstance(row.get("why"), str):
+            raise ValueError(f"{path}: invalid stage/reason {task}/{seed}")
+        if "success" in row and (type(row["success"]) is not bool or row["success"]):
+            raise ValueError(f"{path}: classification outcome mismatch {task}/{seed}")
+        labels[task][seed] = stage
+    if any(set(labels[task]) != SEEDS for task in TASKS):
+        raise ValueError(f"{path}: classifications must cover exactly all failures")
+    seen = set()
+    for row in data["table"]:
+        if not isinstance(row, dict) or not isinstance(row.get("task"), str):
+            raise ValueError(f"{path}: invalid classifier table row")
+        task = row["task"]
+        if task not in TASKS or task in seen:
+            raise ValueError(f"{path}: invalid/duplicate table task")
+        seen.add(task)
+        expected = {"episodes": 50, "failures": 50 - sum(outcomes[task].values()),
+                    **{stage: sum(label == stage for label in labels[task].values()) for stage in STAGES}}
+        for field, count in expected.items():
+            value = row.get(field, 0) if field == "unknown" else row.get(field)
+            if type(value) is not int or value != count:
+                raise ValueError(f"{path}: table {task}/{field} mismatch")
+    if seen != set(TASKS):
+        raise ValueError(f"{path}: incomplete classifier table")
+    return labels, hashlib.sha256(raw).hexdigest()
+
+
+def compare_stages(baseline_root, candidate_root, baseline, candidate, target_stage, samples, seed):
+    b, b_hash = load_stages(baseline_root, baseline)
+    c, c_hash = load_stages(candidate_root, candidate)
+
+    def describe(pairs):
+        transitions = {before: {after: 0 for after in STATES} for before in STATES}
+        for before, after in pairs:
+            transitions[before][after] += 1
+        n = len(pairs)
+        incidence = {}
+        for stage in STAGES:
+            b_count = sum(transitions[stage].values())
+            c_count = sum(transitions[before][stage] for before in STATES)
+            incidence[stage] = {"baseline_count": b_count, "candidate_count": c_count,
+                                "baseline_rate": b_count / n, "candidate_rate": c_count / n,
+                                "difference": (c_count - b_count) / n}
+        return {"episodes": n, "incidence": incidence, "transitions": transitions,
+                "target_to_success": transitions[target_stage]["success"],
+                "target_to_other_failure": sum(transitions[target_stage][s] for s in STAGES if s != target_stage),
+                "newly_entered_target": sum(transitions[s][target_stage] for s in STATES if s != target_stage)}
+
+    task_rows, all_pairs, differences = [], [], []
+    for task in TASKS:
+        pairs = [(b[task][s], c[task][s]) for s in sorted(SEEDS)]
+        task_rows.append({"task": task, **describe(pairs)})
+        all_pairs.extend(pairs)
+        differences.append([int(after == target_stage) - int(before == target_stage) for before, after in pairs])
+    rng = random.Random(seed)
+    draws = sorted(sum(sum(rng.choices(d, k=50)) for d in differences) / 500 for _ in range(samples))
+    overall = describe(all_pairs)
+    return {"target_stage": target_stage, "units": "fraction",
+            "rate_denominator": "all evaluated episodes, not only failures",
+            "difference_direction": "candidate minus baseline; negative target incidence difference is fewer target failures",
+            "tasks": task_rows, "overall": overall,
+            "target_difference": overall["incidence"][target_stage]["difference"],
+            "target_paired_ci95": [percentile(draws, .025), percentile(draws, .975)],
+            "bootstrap": {"samples": samples, "seed": seed, "method": "within-task paired percentile bootstrap"},
+            "failure_analysis_sha256": {"baseline": b_hash, "candidate": c_hash},
+            "transition_orientation": "rows=baseline state, columns=candidate state; counts, including zeros",
+            "limitations": "Observed stage transitions do not prove causality. Unknown remains separate. Diagnostic only; no implicit model or score selection. Conditional on fitted models and tasks, not training-seed uncertainty."}
+
+
+def compare(baseline_root, candidate_root, bootstrap_samples=10000, bootstrap_seed=1000, target_stage=None):
+    if type(bootstrap_samples) is not int or bootstrap_samples < 2:
+        raise ValueError("bootstrap_samples must be an integer >= 2")
+    if target_stage is not None and target_stage not in TARGET_STAGES:
+        raise ValueError("target_stage must be one of the five official failure stages")
+    baseline, candidate = load_results(baseline_root), load_results(candidate_root)
+    rows, differences = [], []
+    gains = losses = 0
+    for task in TASKS:
+        b, c = baseline[task], candidate[task]
+        diff = [int(c[s]) - int(b[s]) for s in sorted(SEEDS)]
+        differences.append(diff)
+        gained, lost = diff.count(1), diff.count(-1)
+        gains += gained
+        losses += lost
+        rows.append({"task": task, "episodes": 50,
+                     "baseline_successes": sum(b.values()), "candidate_successes": sum(c.values()),
+                     "baseline_rate": sum(b.values()) / 50, "candidate_rate": sum(c.values()) / 50,
+                     "difference": sum(diff) / 50, "gains": gained, "losses": lost})
+    rng = random.Random(bootstrap_seed)
+    draws = sorted(sum(sum(rng.choices(d, k=50)) for d in differences) / 500
+                   for _ in range(bootstrap_samples))
+    lo, hi = percentile(draws, .025), percentile(draws, .975)
+    difference = (gains - losses) / 500
+    verdict = ("supports_meaningful_gain" if difference >= .05 and lo > 0 else
+               "rules_out_5pp_gain_at_this_precision" if hi < .05 else "inconclusive")
+    result = {"tasks": rows, "episodes_per_condition": 500, "units": "fraction",
+              "difference": difference, "paired_ci95": [lo, hi], "gains": gains, "losses": losses,
+              "practical_threshold": .05, "verdict": verdict,
+              "bootstrap": {"samples": bootstrap_samples, "seed": bootstrap_seed,
+                            "method": "within-task paired percentile bootstrap"},
+              "limitations": "Conditional on fixed tasks and fitted models; no training-seed or rendering-repeat variance."}
+    for label in ("baseline", "candidate"):
+        rates = [row[f"{label}_rate"] for row in rows]
+        result[label] = {"macro_mean": statistics.mean(rates),
+                         "task_sample_sd": statistics.stdev(rates)}
+    if target_stage is not None:
+        result["stage_comparison"] = compare_stages(
+            baseline_root, candidate_root, baseline, candidate, target_stage, bootstrap_samples, bootstrap_seed)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline", type=Path, required=True)
+    parser.add_argument("--candidate", type=Path, required=True)
+    parser.add_argument("--bootstrap-samples", type=int, default=10000)
+    parser.add_argument("--bootstrap-seed", type=int, default=1000)
+    parser.add_argument("--target-stage", choices=TARGET_STAGES, help="optional diagnostic stage comparison")
+    args = parser.parse_args()
+    try:
+        result = compare(args.baseline, args.candidate, args.bootstrap_samples, args.bootstrap_seed, args.target_stage)
+    except (ValueError, OSError) as exc:
+        parser.error(str(exc))
+    print(json.dumps(result, indent=2, allow_nan=False))
+
+
+if __name__ == "__main__":
+    main()
