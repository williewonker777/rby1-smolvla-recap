index 0000000000000000000000000000000000000000..142827ce39059ecddfde87ba4183a74e5de70f22
--- /dev/null
+++ b/vla_lab/collect_recap_rollouts.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# Training/dev ONLY. Isaac fast shutdown can exit(0) with an exception pending;
+# require a private completion receipt in addition to the process exit code.
+set -euo pipefail
+RBY_PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+export PYTHONPATH="$RBY_PROJECT_DIR/vla_lab/scripts${PYTHONPATH:+:$PYTHONPATH}"
+for arg in "$@"; do
+    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
+        exec "$RBY_PROJECT_DIR/run_python.sh" "$RBY_PROJECT_DIR/vla_lab/scripts/collect_recap_rollouts.py" "$@"
+    fi
+done
+RECAP_COMPLETION_RECEIPT="$(mktemp "${TMPDIR:-/tmp}/recap-completion.XXXXXXXX")"
+export RECAP_COMPLETION_RECEIPT
+trap 'rm -f -- "$RECAP_COMPLETION_RECEIPT"' EXIT
+status=0
+"$RBY_PROJECT_DIR/run_python.sh" "$RBY_PROJECT_DIR/vla_lab/scripts/collect_recap_rollouts.py" "$@" || status=$?
+if [[ "$status" -ne 0 ]]; then
+    exit "$status"
+fi
+if [[ "$(cat -- "$RECAP_COMPLETION_RECEIPT")" != "completed" ]]; then
+    echo "RECAP_COLLECTION_FAILED: subprocess exited without completing all requested episodes; inspect traceback and .pending/error.json" >&2
+    exit 1
+fi
diff --git a/vla_lab/scripts/archive_oracle_pixels.py b/vla_lab/scripts/archive_oracle_pixels.py
new file mode 100644
index 0000000000000000000000000000000000000000..3def591277fde751b213d376cc602e65186c0a79
--- /dev/null
+++ b/vla_lab/scripts/archive_oracle_pixels.py
@@ -0,0 +1,176 @@
+"""Lossless camera storage. Archive/prune/restore leave numeric episode files untouched.
+
+Use --ffmpeg to select the course environment's binary. Never operate on a
+recording episode. Restore regenerates PNG bytes, but RGB pixels are identical.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def run(ffmpeg, args):
+    subprocess.run([ffmpeg, '-v', 'error', '-nostdin', '-threads', '1',
+                    '-filter_threads', '1', *args], check=True)
+
+
+def digest(ffmpeg, args, expected):
+    with tempfile.TemporaryFile() as errors:
+        p = subprocess.Popen([ffmpeg, '-v', 'error', '-nostdin', '-threads', '1',
+                              '-filter_threads', '1', *args, '-f', 'rawvideo',
+                              '-pix_fmt', 'rgb24', '-threads', '1', '-'],
+                             stdout=subprocess.PIPE, stderr=errors)
+        h = hashlib.sha256()
+        count = 0
+        for block in iter(lambda: p.stdout.read(1024 * 1024), b''):
+            count += len(block)
+            h.update(block)
+        rc = p.wait()
+        p.stdout.close()
+        if rc or count != expected:
+            raise ValueError(f'decoding failed: exit={rc}, bytes={count}, expected={expected}')
+        return h.hexdigest()
+
+
+def schema(episode):
+    m = json.loads((episode / 'episode.json').read_text())
+    if m.get('status') != 'saved' or type(m.get('frames')) is not int or m['frames'] <= 0:
+        raise ValueError('only complete saved episodes are supported')
+    cameras = m['cameras']
+    if not cameras or len(cameras) != len(set(cameras)):
+        raise ValueError('invalid cameras')
+    for c in cameras:
+        if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_]*', c):
+            raise ValueError('unsafe camera name')
+        h, w = m['camera_sizes'][c]
+        if any(type(v) is not int or not 0 < v <= 16384 for v in (h, w)):
+            raise ValueError('invalid dimensions')
+    return m
+
+
+def images(episode, camera, frames):
+    d = episode / camera
+    names = [f'{i:06d}.png' for i in range(frames)]
+    if d.is_symlink() or sorted(p.name for p in d.iterdir()) != names:
+        raise ValueError('camera frames must be contiguous with no extra files')
+    if any((d / n).is_symlink() or not (d / n).is_file() for n in names):
+        raise ValueError('unsafe frame')
+    return ['-framerate', '15', '-i', str(d / '%06d.png')]
+
+
+def sync(path):
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def archive(episode, target, ffmpeg, codec="ffv1"):
+    if codec not in ("ffv1", "x264rgb"):
+        raise ValueError("unsupported lossless codec")
+    episode, target = Path(episode), Path(target)
+    m = schema(episode)
+    if target.exists():
+        raise FileExistsError(target)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix='.pixels-', dir=target.parent) as tmp:
+        tmp = Path(tmp)
+        manifest = {'version': 1, 'codec': codec, 'episode_metadata_sha256': hashlib.sha256(
+            (episode / 'episode.json').read_bytes()).hexdigest(), 'cameras': {}}
+        for c in m['cameras']:
+            h, w = m['camera_sizes'][c]
+            expected = m['frames'] * h * w * 3
+            source = images(episode, c, m['frames'])
+            original = digest(ffmpeg, source, expected)
+            video = tmp / f'{c}.mkv'
+            encoding = (['-c:v', 'ffv1', '-level', '3', '-pix_fmt', 'bgr0']
+                        if codec == 'ffv1' else
+                        ['-c:v', 'libx264rgb', '-crf', '0', '-preset', 'fast', '-pix_fmt', 'rgb24'])
+            run(ffmpeg, source + encoding + ['-threads', '1', str(video)])
+            if digest(ffmpeg, ['-i', str(video)], expected) != original:
+                raise ValueError('lossless pixel verification failed')
+            # Prove PNG regeneration too, before authorizing any future pruning.
+            with tempfile.TemporaryDirectory(dir=tmp) as restored:
+                run(ffmpeg, ['-i', str(video), '-start_number', '0', '-threads', '1',
+                             str(Path(restored) / '%06d.png')])
+                if digest(ffmpeg, ['-framerate', '15', '-i', str(Path(restored) / '%06d.png')], expected) != original:
+                    raise ValueError('restore pixel verification failed')
+            manifest['cameras'][c] = {'rgb_sha256': original, 'rgb_bytes': expected}
+            sync(video)
+        (tmp / 'manifest.json').write_text(json.dumps(manifest, indent=2))
+        sync(tmp / 'manifest.json')
+        sync(tmp)
+        os.rename(tmp, target)
+        sync(target.parent)
+    return manifest
+
+
+def verify(episode, target, ffmpeg):
+    m = schema(episode)
+    manifest = json.loads((target / 'manifest.json').read_text())
+    if manifest.get('version') != 1 or manifest['episode_metadata_sha256'] != hashlib.sha256((episode / 'episode.json').read_bytes()).hexdigest():
+        raise ValueError('metadata mismatch')
+    if set(manifest['cameras']) != set(m['cameras']):
+        raise ValueError('camera mismatch')
+    for c, row in manifest['cameras'].items():
+        h, w = m['camera_sizes'][c]
+        if row['rgb_bytes'] != m['frames'] * h * w * 3 or digest(ffmpeg, ['-i', str(target / f'{c}.mkv')], row['rgb_bytes']) != row['rgb_sha256']:
+            raise ValueError('archive damaged')
+        # If originals or restored PNGs exist, verify these too. Absent camera
+        # folders are expected after a verified prune.
+        if (episode / c).exists() or (episode / c).is_symlink():
+            if digest(ffmpeg, images(episode, c, m['frames']), row['rgb_bytes']) != row['rgb_sha256']:
+                raise ValueError('source pixels differ from archive')
+    return m, manifest
+
+
+def prune(episode, target, ffmpeg):
+    m, manifest = verify(episode, target, ffmpeg)
+    # Check every source before removing anything. No unrelated files are pruned.
+    for c, row in manifest['cameras'].items():
+        if digest(ffmpeg, images(episode, c, m['frames']), row['rgb_bytes']) != row['rgb_sha256']:
+            raise ValueError('source changed')
+    for c in m['cameras']:
+        for i in range(m['frames']):
+            (episode / c / f'{i:06d}.png').unlink()
+        (episode / c).rmdir()
+    sync(episode)
+
+
+def restore(episode, target, ffmpeg):
+    m, manifest = verify(episode, target, ffmpeg)
+    if any((episode / c).exists() for c in m['cameras']):
+        raise FileExistsError('refusing to overwrite camera directories')
+    with tempfile.TemporaryDirectory(prefix='.restore-', dir=episode) as tmp:
+        for c, row in manifest['cameras'].items():
+            d = Path(tmp) / c
+            d.mkdir()
+            run(ffmpeg, ['-i', str(target / f'{c}.mkv'), '-start_number', '0', '-threads', '1', str(d / '%06d.png')])
+            if digest(ffmpeg, images(Path(tmp), c, m['frames']), row['rgb_bytes']) != row['rgb_sha256']:
+                raise ValueError('restore mismatch')
+        for c in m['cameras']:
+            for image in (Path(tmp) / c).iterdir():
+                sync(image)
+            sync(Path(tmp) / c)
+            os.rename(Path(tmp) / c, episode / c)
+    sync(episode)
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('mode', choices=['archive', 'verify', 'prune', 'restore'])
+    p.add_argument('episode', type=Path)
+    p.add_argument('archive', type=Path)
+    p.add_argument('--ffmpeg', default='ffmpeg')
+    p.add_argument('--codec', choices=['ffv1', 'x264rgb'], default='ffv1', help='archive encoding only')
+    a = p.parse_args()
+    if a.mode == 'archive':
+        archive(a.episode, a.archive, a.ffmpeg, codec=a.codec)
+    else:
+        globals()[a.mode](a.episode, a.archive, a.ffmpeg)
+    print(f'{a.mode}: verified')
diff --git a/vla_lab/scripts/audit_oracle_pngs.py b/vla_lab/scripts/audit_oracle_pngs.py
new file mode 100644
index 0000000000000000000000000000000000000000..b246298c74ece8501ef0d6314e681dc7fd3d6744
--- /dev/null
+++ b/vla_lab/scripts/audit_oracle_pngs.py
@@ -0,0 +1,76 @@
+"""Read-only camera count, shape and PNG integrity gate before course export."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import json
+from pathlib import Path
+import time
+
+from PIL import Image
+
+from archive_oracle_pixels import images, schema
+
+CAMERAS = ('first_person', 'left_hand', 'right_hand')
+
+
+def audit_episode(episode):
+    checked = 0
+    violations = []
+    try:
+        if episode.is_symlink():
+            raise ValueError('unsafe episode path')
+        meta = schema(episode)
+        if meta['fps'] != 15 or set(meta['cameras']) != set(CAMERAS):
+            raise ValueError('expected native 15fps with all three course cameras')
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        return checked, [{'episode': episode.name, 'error': str(error)}]
+    for camera in CAMERAS:
+        try:
+            images(episode, camera, meta['frames'])  # same contiguous frame contract as archive
+        except (OSError, ValueError) as error:
+            violations.append({'episode': episode.name, 'camera': camera, 'error': str(error)})
+            continue
+        height, width = meta['camera_sizes'][camera]
+        for index in range(meta['frames']):
+            frame = episode / camera / f'{index:06d}.png'
+            checked += 1
+            try:
+                with Image.open(frame) as image:
+                    if image.format != 'PNG' or image.mode != 'RGB' or image.size != (width, height):
+                        raise ValueError('camera mode, format or shape differs from raw metadata')
+                    image.verify()
+            except (OSError, ValueError, SyntaxError) as error:
+                violations.append({'episode': episode.name, 'frame': f'{camera}/{frame.name}',
+                                   'error': str(error)})
+    return checked, violations
+
+
+def audit(root, expected, workers=4):
+    if not root.is_dir() or expected < 1 or not 1 <= workers <= 8:
+        raise ValueError('require existing raw root and bounded positive episode/worker counts')
+    started = time.monotonic()
+    episodes = sorted(path for path in root.glob('episode-*') if path.is_dir())
+    violations = []
+    if len(episodes) != expected:
+        violations.append({'error': 'unexpected episode count', 'expected': expected, 'actual': len(episodes)})
+    checked = 0
+    with ThreadPoolExecutor(max_workers=workers) as pool:
+        for n, errors in pool.map(audit_episode, episodes):
+            checked += n
+            violations.extend(errors)
+    return dict(passed=not violations, episodes=len(episodes), images_checked=checked,
+                violations=violations, seconds=round(time.monotonic() - started, 3))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('raw_root', type=Path)
+    parser.add_argument('--episodes', type=int, default=50)
+    parser.add_argument('--workers', type=int, default=4)
+    args = parser.parse_args()
+    result = audit(args.raw_root, args.episodes, args.workers)
+    print(json.dumps(result, indent=2))
+    return 0 if result['passed'] else 2
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/vla_lab/scripts/build_recap_mixed.py b/vla_lab/scripts/build_recap_mixed.py
new file mode 100644
index 0000000000000000000000000000000000000000..9b70053f17ca990a99c03289ada6fd1328c6642d
--- /dev/null
+++ b/vla_lab/scripts/build_recap_mixed.py
@@ -0,0 +1,247 @@
+"""Build the fixed same-data B1/R1 corpus, retaining oracle terminal rows.
+
+Only main() defines the production counts: all ten tasks, 50 oracle/task, and a
+preregistered prefix of 20..50 train-only on-policy episodes/task. Never uploads.
+The actor consumer MUST filter frame_index >= preterminal_actions for both arms.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+import numpy as np
+
+TASKS = [f"T{i}" for i in range(1, 11)]
+DATASET_ID = "local/RBY1-T1-T10-RECAP-MIXED"
+
+
+def digest_file(path):
+    h = hashlib.sha256()
+    with Path(path).open("rb") as f:
+        for block in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def load_json(path):
+    return json.loads(Path(path).read_text())
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def numeric_hash(states, actions):
+    h = hashlib.sha256()
+    for array in (states, actions):
+        array = np.asarray(array, dtype="<f4")
+        require(array.ndim == 2 and array.shape[1] == 16 and np.isfinite(array).all(), "Invalid numeric rows")
+        h.update(str(array.shape).encode())
+        h.update(array.tobytes(order="C"))
+    return h.hexdigest()
+
+
+def read_dataset(root):
+    """Use actual index columns, not parquet file enumeration, for every join."""
+    import pyarrow as pa
+    import pyarrow.parquet as pq
+    from lerobot.datasets.lerobot_dataset import LeRobotDatasetMetadata
+
+    root = Path(root).resolve()
+    meta = LeRobotDatasetMetadata("local/recap-source", root=root)
+    require(meta.fps == 15 and meta.robot_type == "rby1", "Wrong dataset fps/robot_type")
+    for key in ("front", "right", "left"):
+        require(meta.features[f"observation.images.{key}"]["dtype"] == "video", "Missing camera video")
+        shape = (480, 640, 3) if key == "front" else (640, 480, 3)
+        require(tuple(meta.features[f"observation.images.{key}"]["shape"]) == shape, "Noncanonical camera shape")
+    files = list((root / "data").rglob("*.parquet"))
+    require(bool(files), "Dataset has no numeric data")
+    columns = ["index", "frame_index", "episode_index", "task_index", "observation.state", "action"]
+    table = pa.concat_tables([pq.read_table(p, columns=columns) for p in files]).sort_by("index").to_pydict()
+    n = meta.total_frames
+    require(table["index"] == list(range(n)), "Duplicate/missing absolute indices")
+    result = []
+    episode_indices = np.asarray(table["episode_index"])
+    offset = 0
+    for episode in range(meta.total_episodes):
+        indices = np.flatnonzero(episode_indices == episode)
+        require(len(indices) > 0 and indices.tolist() == list(range(offset, offset + len(indices))), "Noncontiguous episode rows")
+        end = offset + len(indices)
+        require(table["frame_index"][offset:end] == list(range(len(indices))), "Noncontiguous frame indices")
+        tasks = set(table["task_index"][offset:end])
+        require(len(tasks) == 1, "Mixed task indices within episode")
+        task_index = int(next(iter(tasks)))
+        matches = meta.tasks.index[meta.tasks.task_index == task_index].tolist()
+        require(len(matches) == 1, "Unresolved task index")
+        states = np.asarray(table["observation.state"][offset:end], dtype=np.float32)
+        actions = np.asarray(table["action"][offset:end], dtype=np.float32)
+        result.append({"episode_index": episode, "row_start": offset, "row_count": len(indices),
+                       "task_index": task_index, "instruction": str(matches[0]),
+                       "numeric_sha256": numeric_hash(states, actions), "states": states, "actions": actions})
+        offset = end
+    require(offset == n, "Extra unassigned episode rows")
+    return result
+
+
+def oracle_records(root, task, horizon, expected_count=50):
+    import sys
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts"))
+    import rby1_format as R
+
+    root = Path(root)
+    history = load_json(root / "meta/keyboard_episodes.json")
+    rows = read_dataset(root)
+    require(len(history) == len(rows) == expected_count, f"{task}: require {expected_count} complete oracle episodes")
+    by_index = {int(record["episode_index"]): record for record in history}
+    require(len(by_index) == len(history) and set(by_index) == set(range(expected_count)), "Oracle manifest episode index mismatch")
+    records, seeds = [], set()
+    for row in rows:
+        provenance = by_index[row["episode_index"]]
+        raw = Path(provenance["raw_directory"])
+        raw_meta = load_json(raw / "episode.json")
+        seed = provenance.get("initial_layout", {}).get("seed")
+        require(type(seed) is int and 0 <= seed < 4000 and seed not in seeds, "Duplicate/overlapping/out-of-range oracle seed")
+        seeds.add(seed)
+        require(raw_meta.get("status") == "saved", "Incomplete raw oracle")
+        require(load_json(raw / "initial_state.json").get("layout", {}).get("seed") == seed, "Oracle raw/manifest seed contradiction")
+        require(raw_meta.get("scene_sha256") == provenance.get("scene_sha256") and bool(provenance.get("scene_sha256")), "Oracle scene provenance mismatch")
+        require(provenance.get("success_original") is True and raw_meta.get("success_original") is True,
+                "Oracle source must be success_original success")
+        require(not provenance.get("is_smoke_test") and not raw_meta.get("is_smoke_test"), "Smoke data forbidden")
+        require(provenance.get("success_label_source") == raw_meta.get("success_label_source") == "success_original", "Wrong success provenance")
+        require(raw_meta.get("task") == task and raw_meta.get("episode_id") == provenance["raw_episode_id"], "Oracle task/ID contradiction")
+        require(raw_meta.get("instruction") == row["instruction"], "Oracle instruction mismatch")
+        require(provenance.get("format") == "rby1" and provenance.get("resampled") is False and raw_meta["fps"] == 15,
+                "Require native 15fps oracle export")
+        require(provenance["frames"] == provenance["raw_frames"] == raw_meta["frames"] == row["row_count"], "Oracle stale frame counts")
+        with np.load(raw / "trajectory.npz", allow_pickle=False) as data:
+            success = data["success_original"].reshape(-1)
+            require(len(success) == row["row_count"] and np.isin(success, [0, 1]).all(), "Invalid oracle success rows")
+            hits = np.flatnonzero(success)
+            require(len(hits) > 0 and 0 < hits[0] <= horizon, "Missing/nonpositive oracle terminal")
+            terminal = int(hits[0])
+            states = R.state16(data["observation.state"], raw_meta["joint_names"])
+            actions = R.action16(data["action"], raw_meta["joint_names"])
+            require(numeric_hash(states, actions) == row["numeric_sha256"], "Oracle raw/export numeric mismatch")
+        records.append({**{k: v for k, v in row.items() if k not in ("states", "actions")},
+                        "task": task, "source": "oracle", "seed": seed, "success": True, "horizon": horizon,
+                        "preterminal_actions": terminal, "terminal_local_index": terminal,
+                        "source_episode_id": provenance["raw_episode_id"],
+                        "raw_trajectory_sha256": digest_file(raw / "trajectory.npz"),
+                        "source_manifest_sha256": digest_file(root / "meta/keyboard_episodes.json")})
+    return records
+
+
+def rollout_records(root, task, seed, horizon):
+    root = Path(root)
+    require(not root.name.endswith(".pending") and not (root / "error.json").exists(), "Incomplete rollout")
+    m = load_json(root / "manifest.json")
+    require(m.get("schema_version") == 1 and m.get("split") == "train" and m.get("train_eligible") is True, "Nontraining rollout")
+    require(m.get("task") == task and m.get("seed") == seed and 4000 <= seed < 4050, "Rollout task/seed mismatch")
+    require(m.get("action_source") == "autonomous_policy" and m.get("success_label_source") == "success_original", "Rollout provenance mismatch")
+    require(m.get("horizon") == horizon and m.get("fps") == 15, "Rollout benchmark mismatch")
+    require(m.get("dataset") == "dataset" and m.get("terminal_observation") == "terminal_observation.npz"
+            and m.get("execution") == "execution.npz", "Noncanonical rollout artifact paths")
+    rows = read_dataset(root / "dataset")
+    require(len(rows) == 1, "Require one rollout episode per seed")
+    row = rows[0]
+    n = row["row_count"]
+    require(0 < n <= horizon and m.get("executed_actions") == m.get("terminal_observation_index") == n,
+            "Rollout action/endpoint count mismatch")
+    require(m.get("episode_index") == 0 and m.get("actor_frame_indices") == [0, n], "Rollout local join mismatch")
+    require(m.get("instruction") == row["instruction"], "Rollout instruction mismatch")
+    success = m.get("success_original")
+    require(type(success) is bool, "Invalid rollout outcome")
+    require((success and n < horizon and m.get("official_steps") == n + 1 and m.get("termination") == "success_original")
+            or (not success and n == horizon and m.get("official_steps") == horizon and m.get("termination") == "horizon"),
+            "Rollout contradicts official stop semantics")
+    with np.load(root / "execution.npz", allow_pickle=False) as data:
+        require(numeric_hash(data["states"], data["actions"]) == row["numeric_sha256"], "Rollout execution numeric mismatch")
+    with np.load(root / "terminal_observation.npz", allow_pickle=False) as data:
+        require(data["state"].shape == (16,) and np.isfinite(data["state"]).all(), "Invalid endpoint state")
+        for key, shape in {"front": (480, 640, 3), "right": (640, 480, 3), "left": (640, 480, 3)}.items():
+            require(data[key].shape == shape and data[key].dtype == np.uint8, "Invalid endpoint camera")
+    record = {**{k: v for k, v in row.items() if k not in ("states", "actions")}, "task": task,
+              "source": "autonomous", "seed": seed, "success": success, "horizon": horizon,
+              "preterminal_actions": n, "terminal_source": str(root / "terminal_observation.npz"),
+              "terminal_sha256": digest_file(root / "terminal_observation.npz"),
+              "policy_sha256": m["policy"]["sha256"], "n_action_steps": m["n_action_steps"],
+              "source_manifest_sha256": digest_file(root / "manifest.json")}
+    require(isinstance(record["policy_sha256"], str) and len(record["policy_sha256"]) == 64, "Invalid policy revision")
+    return [record]
+
+
+def assemble(sources, output, horizon_hash):
+    """Aggregate validated sources; reread and verify every resulting episode."""
+    from lerobot.datasets.aggregate import aggregate_datasets
+
+    output = Path(output).resolve()
+    pending = output.with_name(output.name + ".pending")
+    require(not output.exists() and not pending.exists(), "Output exists or interrupted; never overwrite")
+    expected = [{**record, "source_dataset_index": i}
+                for i, (_, records) in enumerate(sources) for record in records]
+    require(bool(expected), "No input episodes")
+    policy_revisions = {(r["policy_sha256"], r["n_action_steps"]) for r in expected if r["source"] == "autonomous"}
+    require(len(policy_revisions) == 1, "Rollouts must share one policy revision and execution configuration")
+    require(len({(r["task"], r["seed"]) for r in expected}) == len(expected), "Duplicate task/seed")
+    for task in {r["task"] for r in expected}:
+        require(len({r["instruction"] for r in expected if r["task"] == task}) == 1, "Task instruction differs between sources")
+    source_videos = [{str(p.relative_to(Path(root))): digest_file(p)
+                      for p in sorted((Path(root) / "videos").rglob("*.mp4"))} for root, _ in sources]
+    require(all(source_videos), "Missing source video files")
+    aggregate_datasets(repo_ids=[f"local/source-{i}" for i in range(len(sources))],
+                       aggr_repo_id=DATASET_ID, roots=[Path(root) for root, _ in sources], aggr_root=pending)
+    actual = read_dataset(pending)
+    require(len(actual) == len(expected), "Aggregated episode count mismatch")
+    episodes = []
+    for idx, (want, got) in enumerate(zip(expected, actual)):
+        for key in ("row_count", "instruction", "numeric_sha256"):
+            require(want[key] == got[key], f"Aggregated episode {idx} mismatch: {key}")
+        record = {**want, **{k: v for k, v in got.items() if k not in ("states", "actions")}}
+        record["source_episode_index"] = want["episode_index"]
+        record["source_row_start"] = want["row_start"]
+        if record["source"] == "oracle":
+            record["terminal_index"] = got["row_start"] + record.pop("terminal_local_index")
+        else:
+            terminal = pending / "recap_terminals" / f"episode-{idx:06d}.npz"
+            terminal.parent.mkdir(exist_ok=True)
+            shutil.copyfile(record.pop("terminal_source"), terminal)
+            require(digest_file(terminal) == record["terminal_sha256"], "Endpoint copy checksum mismatch")
+            record["terminal_path"] = str(terminal.relative_to(pending))
+        episodes.append(record)
+    identity = {"schema_version": 1, "horizon_sha256": horizon_hash, "episodes": episodes,
+                "source_video_sha256": source_videos}
+    dataset_sha256 = hashlib.sha256(json.dumps(identity, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+    manifest = {**identity, "dataset_id": DATASET_ID, "dataset_sha256": dataset_sha256,
+                "actor_contract": "Both B1/R1: start frames < preterminal_actions; pad targets at canonical terminal; never train terminal actor rows",
+                "episode_count": len(episodes), "row_count": sum(e["row_count"] for e in episodes)}
+    (pending / "recap_manifest.json").write_text(json.dumps(manifest, indent=2))
+    pending.rename(output)
+    return manifest
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--oracle-root", type=Path, required=True, help="Contains T1/oracle through T10/oracle")
+    p.add_argument("--rollout-root", type=Path, required=True, help="Collector root containing train/Tn/seed-N")
+    p.add_argument("--output", type=Path, required=True)
+    p.add_argument("--rollouts-per-task", type=int, default=20, help="Preregistered contiguous prefix, 20..50")
+    args = p.parse_args()
+    require(20 <= args.rollouts_per_task <= 50, "Require preregistered 20..50 rollouts/task")
+    horizon_path = Path(__file__).resolve().parents[1] / "eval_horizons.json"
+    horizons = load_json(horizon_path)
+    sources = []
+    for task in TASKS:
+        root = args.oracle_root / task / "oracle"
+        sources.append((root, oracle_records(root, task, int(horizons[task]))))
+        for seed in range(4000, 4000 + args.rollouts_per_task):
+            root = args.rollout_root / "train" / task / f"seed-{seed}"
+            sources.append((root / "dataset", rollout_records(root, task, seed, int(horizons[task]))))
+    manifest = assemble(sources, args.output, digest_file(horizon_path))
+    print(json.dumps({k: manifest[k] for k in ("dataset_id", "dataset_sha256", "episode_count", "row_count")}))
+
+
+if __name__ == "__main__":
+    main()
