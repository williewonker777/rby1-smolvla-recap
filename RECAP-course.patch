+class DiagnosticTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        table, details = [], []
+        for task in module.TASKS:
+            directory = self.root / task
+            directory.mkdir()
+            episodes = []
+            for seed in sorted(module.SEEDS):
+                success = seed % 2 == 0
+                episodes.append({"task": task, "seed": seed, "success": success})
+                np.savez(directory / f"episode_seed{seed}.npz", trace=np.array(['{}']), success=success)
+                if not success:
+                    details.append({"task": task, "seed": seed, "stage": "grasp", "why": "not lifted"})
+            video = f"{task}_failure_seed100001.mp4"
+            (directory / video).write_bytes(b"synthetic path fixture, not a playable video")
+            videos = {"success": None, "failure": video}
+            self.write(directory / "episodes.json", episodes)
+            self.write(directory / "summary.json", {"task": task, "episodes": 50, "successes": 25, "videos": videos})
+            table.append({"task": task, "episodes": 50, "failures": 25, "videos": videos,
+                          **{s: 25 if s == "grasp" else 0 for s in module.STAGES if s != "unknown"}})
+        self.analysis_path = self.root / "failure_analysis.json"
+        self.write(self.analysis_path, {"table": table, "episodes": details})
+
+    def write(self, path, value):
+        path.write_text(json.dumps(value))
+
+    def edit(self, path, change):
