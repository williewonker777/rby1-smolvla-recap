+
+class ProcessorTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.labels = self.root / 'labels.json'
+        self.document = {'schema_version': 1, 'dataset_id': 'local/merged', 'rows': [
+            {'index': i, 'episode_index': 7, 'task_index': 2, 'task': 'Pick cube', 'indicator': i % 2}
+            for i in range(100)]}
+        self.config = self.write_labels()
+        self.batch = {'task': ['Pick cube'] * 100, 'index': torch.arange(100),
+                      'episode_index': torch.full((100,), 7), 'task_index': torch.full((100,), 2)}
+
+    def write_labels(self):
+        self.labels.write_text(json.dumps(self.document))
+        return {'labels_path': str(self.labels), 'dataset_id': 'local/merged',
+                'labels_sha256': hashlib.sha256(self.labels.read_bytes()).hexdigest()}
+
+    def test_truthful_and_drop_all(self):
+        result = TrainingAdvantageStep(**self.config, dropout_probability=0).complementary_data(self.batch)
+        self.assertEqual(result['task'][:2], ['Pick cube\nAdvantage: negative', 'Pick cube\nAdvantage: positive'])
+        result = TrainingAdvantageStep(**self.config, dropout_probability=1).complementary_data(self.batch)
+        self.assertEqual(result['task'], self.batch['task'])
+        self.assertEqual(self.batch['task'], ['Pick cube'] * 100)
+
+    def test_rng_independent_reproducible_and_resume(self):
+        a, b = TrainingAdvantageStep(**self.config), TrainingAdvantageStep(**self.config)
+        random_state, torch_state = random.getstate(), torch.random.get_rng_state().clone()
+        result = a.complementary_data(self.batch)
+        self.assertEqual(result['task'], b.complementary_data(self.batch)['task'])
+        dropped = sum(task == 'Pick cube' for task in result['task'])
+        self.assertTrue(15 < dropped < 45, dropped)
+        self.assertEqual(random_state, random.getstate())
+        self.assertTrue(torch.equal(torch_state, torch.random.get_rng_state()))
+        restored = TrainingAdvantageStep(**self.config)
+        restored.load_state_dict(a.state_dict())
+        self.assertEqual(a.complementary_data(self.batch)['task'], restored.complementary_data(self.batch)['task'])
+
+    def test_sidecar_rejects_bad_metadata(self):
+        original = json.loads(json.dumps(self.document))
+        for change in (lambda d: d['rows'].append(d['rows'][0]),
+                       lambda d: d['rows'][0].update(indicator=True),
+                       lambda d: d['rows'][0].update(indicator=2),
+                       lambda d: d['rows'][0].update(index=0.0),
+                       lambda d: d['rows'][0].update(task_index=3),
+                       lambda d: d['rows'][0].update(extra=1),
+                       lambda d: d.update(schema_version=True)):
+            self.document = json.loads(json.dumps(original))
+            change(self.document)
+            with self.assertRaises(ValueError):
+                TrainingAdvantageStep(**self.write_labels())
+        with self.assertRaises(ValueError):
+            TrainingAdvantageStep(**self.config)  # stale digest
+
+    def test_batch_join_fail_closed(self):
+        step = TrainingAdvantageStep(**self.config)
+        for field, value in [('index', torch.arange(100) + 1),
+                             ('episode_index', torch.ones(100, dtype=torch.int64)),
+                             ('task_index', torch.ones(100, dtype=torch.float32)),
+                             ('task', ['Wrong'] * 100), ('index', [[0]] * 100)]:
+            with self.subTest(field=field), self.assertRaises(ValueError):
+                step.complementary_data({**self.batch, field: value})
+        with self.assertRaises(ValueError):
+            step.complementary_data({'task': 'Pick cube'})
+
+    def test_positive_has_no_training_config(self):
+        step = PositiveAdvantageStep()
+        self.assertEqual(step.get_config(), {})
+        self.assertEqual(step.state_dict(), {})
+        self.assertEqual(step.complementary_data({'task': 'Pick cube'})['task'], 'Pick cube\nAdvantage: positive')
+        with self.assertRaises(ValueError):
+            step.complementary_data({'task': 'Pick cube\nAdvantage: positive'})
+
+    def test_real_batch_conversion_padding_alias(self):
+        mask = torch.tensor([[False, True], [False, False]])
+        pipeline = PolicyProcessorPipeline(steps=[ActionPaddingBridgeStep(), PositiveAdvantageStep()])
+        batch = {'observation.state': torch.zeros(2, 6), 'action': torch.zeros(2, 2, 16),
+                 'task': ['Pick cube', 'Pick cube'], 'action_is_pad': mask}
+        result = pipeline(batch)
+        self.assertIs(result['actions_id_pad'], mask)
+        self.assertIs(result['action_is_pad'], mask)
+        self.assertNotIn('actions_id_pad', batch)
+        self.assertEqual(ActionPaddingBridgeStep().complementary_data({}), {})
+        for invalid in (mask.float(), mask[0]):
+            with self.assertRaises(ValueError):
+                ActionPaddingBridgeStep().complementary_data({'action_is_pad': invalid})
+        with self.assertRaises(ValueError):
+            ActionPaddingBridgeStep().complementary_data({'action_is_pad': mask, 'actions_id_pad': ~mask})
+
+    def test_bridge_reaches_stock_loss(self):
+        from types import SimpleNamespace
+        from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy
+        mask = torch.tensor([[False, True]])
+        pipeline = PolicyProcessorPipeline(steps=[ActionPaddingBridgeStep()])
+        batch = pipeline({'action_is_pad': mask, 'action': torch.zeros(1, 2, 16),
+                          'observation.language.tokens': torch.zeros(1, 48, dtype=torch.int64),
+                          'observation.language.attention_mask': torch.ones(1, 48, dtype=torch.bool)})
+        # Exercise the genuine stock forward/loss, substituting only network outputs.
+        policy = SimpleNamespace(
+            config=SimpleNamespace(adapt_to_pi_aloha=False, max_action_dim=16),
+            prepare_images=lambda b: ([], []), prepare_state=lambda b: torch.zeros(1, 16),
+            prepare_action=lambda b: b['action'],
+            model=SimpleNamespace(forward=lambda *args: torch.ones(1, 2, 16)))
+        loss, diagnostics = SmolVLAPolicy.forward(policy, batch)
+        self.assertEqual(loss.item(), 0.5)
+        self.assertEqual(diagnostics['losses_after_in_ep_bound'][0, 1].sum().item(), 0)
+
+    def test_json_transform_preserves_stock_and_strips_training(self):
+        stock = {'name': 'policy_preprocessor', 'steps': [
+            {'registry_name': 'to_batch_processor', 'config': {}},
+            {'registry_name': 'smolvla_new_line_processor', 'config': {}},
+            {'registry_name': 'tokenizer_processor', 'config': {'max_length': 48}},
+            {'registry_name': 'normalizer_processor', 'config': {'eps': 1e-8}, 'state_file': 'original.safetensors'}]}
+        before = json.dumps(stock)
+        training = configure_pipeline_json(stock, mode='train', training_config=self.config)
+        training['steps'][2]['state_file'] = 'train_rng.safetensors'
+        deploy = configure_pipeline_json(training, mode='deploy')
+        control = configure_pipeline_json(stock, mode='unconditional')
+        for config in (training, deploy, control):
+            self.assertEqual([s for s in config['steps'] if 'registry_name' in s], stock['steps'])
+            self.assertEqual(config['name'], stock['name'])
+        self.assertEqual(json.dumps(stock), before)
+        self.assertNotIn('labels', json.dumps(deploy))
+        self.assertNotIn('train_rng', json.dumps(deploy))
+        self.assertEqual(deploy, configure_pipeline_json(deploy, mode='deploy'))
+
+    def test_checkpoint_reload_fresh_process(self):
+        pipeline = PolicyProcessorPipeline(steps=[ActionPaddingBridgeStep(), PositiveAdvantageStep()], name='policy_preprocessor')
+        pipeline.save_pretrained(self.root)
+        config = json.loads((self.root / 'policy_preprocessor.json').read_text())
+        self.assertEqual(config['steps'][1]['class'], 'recap_processor.PositiveAdvantageStep')
+        self.labels.unlink()  # no deployment dependency
+        code = """
+import sys
+from lerobot.processor import PolicyProcessorPipeline
+p = PolicyProcessorPipeline.from_pretrained(sys.argv[1], config_filename='policy_preprocessor.json')
+assert p({'task':['Pick cube']})['task'] == ['Pick cube\\nAdvantage: positive']
+"""
+        env = {**os.environ, 'CUDA_VISIBLE_DEVICES': '', 'PYTHONPATH': str(SCRIPTS) + os.pathsep + os.environ.get('PYTHONPATH', '')}
+        subprocess.run([sys.executable, '-c', code, str(self.root)], check=True, env=env, timeout=90, capture_output=True)
+
+    def test_training_pipeline_rng_save_reload(self):
+        pipeline = PolicyProcessorPipeline(steps=[TrainingAdvantageStep(**self.config)], name='train_preprocessor')
+        pipeline(self.batch)
+        pipeline.save_pretrained(self.root)
+        restored = PolicyProcessorPipeline.from_pretrained(self.root, config_filename='train_preprocessor.json')
+        self.assertEqual(pipeline(self.batch)['task'], restored(self.batch)['task'])
+
+    @unittest.skipUnless(os.environ.get('RECAP_STOCK_CHECKPOINT'), 'set RECAP_STOCK_CHECKPOINT for cached stock smoke')
+    def test_cached_stock_tokenizer_normalizer(self):
+        from lerobot.policies.smolvla.processor_smolvla import SmolVLANewLineProcessor  # register stock step
+        from safetensors.torch import load_file
+        source = Path(os.environ['RECAP_STOCK_CHECKPOINT'])
+        stock = json.loads((source / 'policy_preprocessor.json').read_text())
+        deploy = configure_pipeline_json(stock, mode='deploy')
+        for step in stock['steps']:
+            if 'state_file' in step:
+                shutil.copyfile(source / step['state_file'], self.root / step['state_file'])
+        (self.root / 'policy_preprocessor.json').write_text(json.dumps(deploy))
+        pipeline = PolicyProcessorPipeline.from_pretrained(self.root, config_filename='policy_preprocessor.json',
+                                                            overrides={'device_processor': {'device': 'cpu'}})
+        output = pipeline({'task': ['Pick cube'], 'observation.state': torch.zeros(1, 16)})
+        self.assertEqual(output['observation.language.tokens'].shape, (1, 48))
+        self.assertTrue(torch.isfinite(output['observation.state']).all())
+        normalizer = next(s for s in stock['steps'] if s.get('registry_name') == 'normalizer_processor')
+        self.assertEqual((source / normalizer['state_file']).read_bytes(), (self.root / normalizer['state_file']).read_bytes())
+        for key, tensor in load_file(str(source / normalizer['state_file'])).items():
+            self.assertTrue(torch.equal(tensor, pipeline.steps[-1].state_dict()[key]))
+
+
+if __name__ == '__main__':
+    unittest.main()
