+@pytest.mark.parametrize("mode,expected", [("success", 0), ("swallowed", 1), ("normal_failure", 7), ("help", 0)])
+def test_shell_detects_swallowed_sim_shutdown_failure(tmp_path, mode, expected):
+    import os
+    import shutil
+    import subprocess
+    wrapper = tmp_path / "vla_lab/collect_recap_rollouts.sh"
+    wrapper.parent.mkdir()
+    shutil.copyfile(MODULE.parents[1] / "collect_recap_rollouts.sh", wrapper)
+    runner = tmp_path / "run_python.sh"
+    runner.write_text('''#!/usr/bin/env bash
+case "$FAKE_MODE" in
+  success) printf 'completed\\n' > "$RECAP_COMPLETION_RECEIPT"; exit 0 ;;
+  swallowed) echo 'fake pending runtime exception' >&2; exit 0 ;;
+  normal_failure) exit 7 ;;
+  help) exit 0 ;;
+esac
+''')
+    runner.chmod(0o755)
+    env = {**os.environ, "FAKE_MODE": mode, "TMPDIR": str(tmp_path)}
+    args = ["bash", str(wrapper)] + (["--help"] if mode == "help" else ["--task", "T1"])
+    result = subprocess.run(args, env=env, capture_output=True, text=True)
+    assert result.returncode == expected, result.stderr
+    if mode == "swallowed":
+        assert "RECAP_COLLECTION_FAILED" in result.stderr
+    assert not list(tmp_path.glob("recap-completion.*"))
