new file mode 100644
index 0000000000000000000000000000000000000000..9dc7b92903b0fb74d53ade63f04eee1117ff21ac
--- /dev/null
+++ b/vla_lab/scripts/recap_actor_data.py
@@ -0,0 +1,194 @@
+"""Identical canonical actor view for BC and RECAP over an unfiltered LeRobotDataset.
+
+Metadata remains the physical source metadata, not a fabricated exported dataset.
+Stock shuffle/DataLoader is supported; physical EpisodeAwareSampler bounds are
+NOT canonical sample indices. The launcher must not enter the stock physical
+sampler branch, even with drop_n_last_frames=0 (its attribute presence triggers
+that branch). Use canonical_episode_ranges for explicitly canonical samplers.
+"""
+from bisect import bisect_right
+from dataclasses import dataclass
+from numbers import Integral
+
+import torch
+from torch.utils.data import Dataset
+
+
+@dataclass(frozen=True)
+class EpisodeSpan:
+    episode_index: int
+    row_start: int
+    row_count: int
+    preterminal_actions: int
+    task: str
+    task_index: int
+    instruction: str
+    source: str
+    seed: int
+
+
+def _integer(value, name):
+    if isinstance(value, torch.Tensor):
+        if value.numel() != 1 or value.dtype not in (torch.int8, torch.int16, torch.int32, torch.int64, torch.uint8):
+            raise ValueError(f'{name} must be one integer')
+        value = value.item()
+    if isinstance(value, bool) or not isinstance(value, Integral) or value < 0:
+        raise ValueError(f'{name} must be a nonnegative integer')
+    return int(value)
+
+
+class CanonicalActorView(Dataset):
+    """Exclude terminal starts and scrub padded action targets without copying RGB.
+
+    Spans must cover the complete physical dataset, ordered by episode and row.
+    Oracle can retain extra raw rows after its first successful observation;
+    autonomous has exactly T actor rows and an external terminal observation NPZ,
+    never an extra physical actor row. The caller proves terminal outcomes
+    and source provenance before constructing spans; this view checks alignment.
+    Each item retains its underlying absolute index and gets action_is_pad [K].
+    The shared ActionPaddingBridgeStep later batches/aliases that boolean mask.
+    """
+    def __init__(self, dataset, spans, chunk_size=50):
+        self.dataset = dataset
+        self.spans = tuple(spans)
+        self.chunk_size = _integer(chunk_size, 'chunk_size')
+        if not self.chunk_size or not self.spans:
+            raise ValueError('nonempty spans and positive chunk_size required')
+        if dataset.episodes is not None:
+            raise ValueError('episode-subset datasets are not supported: require full absolute row indexing')
+        if dataset.delta_indices is None or list(dataset.delta_indices.get('action', [])) != list(range(self.chunk_size)):
+            raise ValueError('action delta_indices must be contiguous 0..chunk_size-1')
+        dataset._ensure_hf_dataset_loaded()
+        self._ends = []
+        self.canonical_episode_ranges = []
+        indices = []
+        row_end = sample_end = 0
+        seen = set()
+        task_identity = {}
+        instruction_identity = {}
+        if len(self.spans) != dataset.meta.total_episodes:
+            raise ValueError('spans must cover all physical episodes')
+        for number, span in enumerate(self.spans):
+            if not isinstance(span, EpisodeSpan):
+                raise ValueError('spans must contain EpisodeSpan instances')
+            for field in ('episode_index', 'row_start', 'row_count', 'preterminal_actions', 'task_index', 'seed'):
+                _integer(getattr(span, field), field)
+            if span.episode_index != number or span.row_start != row_end:
+                raise ValueError('spans must be contiguous in absolute episode/row order')
+            if not 0 < span.preterminal_actions <= span.row_count:
+                raise ValueError('each episode needs valid physical actor actions')
+            if span.task not in tuple(f'T{i}' for i in range(1, 11)) or not isinstance(span.instruction, str) or not span.instruction.strip():
+                raise ValueError('invalid task or instruction')
+            if span.source not in ('oracle', 'autonomous'):
+                raise ValueError('only oracle/autonomous sources supported; no corrections')
+            if (span.source == 'oracle' and not 0 <= span.seed < 4000) or (span.source == 'autonomous' and not 4000 <= span.seed <= 4049):
+                raise ValueError('seed outside source-specific training range')
+            if span.source == 'oracle' and span.row_count <= span.preterminal_actions:
+                raise ValueError('oracle requires its physical terminal observation row')
+            if span.source == 'autonomous' and span.row_count != span.preterminal_actions:
+                raise ValueError('autonomous requires exactly T actor rows; terminal is external')
+            if (span.task, span.seed) in seen:
+                raise ValueError('duplicate task/seed')
+            seen.add((span.task, span.seed))
+            identity = (span.task_index, span.instruction)
+            if span.task in task_identity and task_identity[span.task] != identity:
+                raise ValueError('inconsistent task identity')
+            if span.task_index in instruction_identity and instruction_identity[span.task_index] != (span.task, span.instruction):
+                raise ValueError('task_index maps to multiple tasks')
+            task_identity[span.task] = identity
+            instruction_identity[span.task_index] = (span.task, span.instruction)
+            meta = dataset.meta.episodes[span.episode_index]
+            if (meta['dataset_from_index'] != span.row_start or meta['dataset_to_index'] != span.row_start + span.row_count
+                    or meta['length'] != span.row_count):
+                raise ValueError('physical episode metadata does not match span')
+            if span.task_index >= len(dataset.meta.tasks) or dataset.meta.tasks.iloc[span.task_index].name != span.instruction:
+                raise ValueError('physical instruction identity mismatch')
+            # Read only numeric identity columns: no video decode or simulator.
+            for key, expected in (
+                ('index', range(span.row_start, span.row_start + span.row_count)),
+                ('frame_index', range(span.row_count)),
+                ('episode_index', [span.episode_index]*span.row_count),
+                ('task_index', [span.task_index]*span.row_count),
+            ):
+                column = dataset.hf_dataset.select_columns([key])[span.row_start:span.row_start+span.row_count][key]
+                if len(column) != span.row_count or any(_integer(v, key) != e for v, e in zip(column, expected, strict=True)):
+                    raise ValueError(f'physical {key} sequence mismatch')
+            indices.extend(range(span.row_start, span.row_start + span.preterminal_actions))
+            self.canonical_episode_ranges.append((sample_end, sample_end + span.preterminal_actions))
+            sample_end += span.preterminal_actions
+            self._ends.append(sample_end)
+            row_end += span.row_count
+        if row_end != len(dataset) or row_end != len(dataset.hf_dataset) or row_end != dataset.meta.total_frames:
+            raise ValueError('physical row count mismatch')
+        self.absolute_indices = tuple(indices)
+        self.canonical_episode_ranges = tuple(self.canonical_episode_ranges)
+
+    def __len__(self):
+        return len(self.absolute_indices)
+
+    def __getitem__(self, index):
+        if isinstance(index, bool) or not isinstance(index, Integral):
+            raise TypeError('canonical sample index must be a scalar integer')
+        if not 0 <= index < len(self):
+            raise IndexError('canonical sample index out of bounds')
+        span = self.spans[bisect_right(self._ends, index)]
+        absolute = self.absolute_indices[index]
+        frame = absolute - span.row_start
+        item = dict(self.dataset[absolute])
+        for key, expected in (('index', absolute), ('episode_index', span.episode_index),
+                              ('frame_index', frame), ('task_index', span.task_index)):
+            if key not in item or _integer(item[key], key) != expected:
+                raise ValueError(f'loaded {key} identity mismatch')
+        if item.get('task') != span.instruction:
+            raise ValueError('loaded instruction identity mismatch')
+        actions, padding = item.get('action'), item.get('action_is_pad')
+        if not isinstance(actions, torch.Tensor) or actions.ndim != 2 or actions.shape[0] != self.chunk_size or not actions.is_floating_point() or not torch.isfinite(actions).all():
+            raise ValueError('action must be a finite floating [chunk_size, action_dim] tensor')
+        if not isinstance(padding, torch.Tensor) or padding.dtype != torch.bool or padding.shape != (self.chunk_size,):
+            raise ValueError('action_is_pad must be a boolean [chunk_size] tensor')
+        expected_physical = torch.arange(self.chunk_size, device=padding.device) + frame >= span.row_count
+        if not torch.equal(padding, expected_physical):
+            raise ValueError('stock padding disagrees with physical episode boundary')
+        mask = padding | (torch.arange(self.chunk_size, device=padding.device) + frame >= span.preterminal_actions)
+        if mask[0]:
+            raise ValueError('actor sample has no valid action')
+        scrubbed = actions.clone()
+        last_valid = int((~mask).sum().item()) - 1
+        scrubbed[mask.to(actions.device)] = actions[last_valid]
+        item['action'] = scrubbed
+        item['action_is_pad'] = mask
+        if 'actions_id_pad' in item:
+            raise ValueError('padding alias must be introduced only by the shared processor')
+        return item
+
+    @property
+    def num_frames(self):
+        return len(self)
+
+    @property
+    def num_episodes(self):
+        return len(self.spans)
+
+    @property
+    def meta(self):
+        return self.dataset.meta
+
+    @property
+    def episodes(self):
+        return None
+
+    @property
+    def features(self):
+        return self.dataset.features
+
+    @property
+    def fps(self):
+        return self.dataset.fps
+
+    @property
+    def root(self):
+        return self.dataset.root
+
+    @property
+    def repo_id(self):
+        return self.dataset.repo_id
