+"""Separate training-only on-policy collection; never modifies the course evaluator.
+
+Each task/seed contains one LeRobot v3 episode (only executed actions), a separate
+terminal observation, exact numeric provenance, and a manifest. Failed rollouts
+are valid data. Interrupted .pending directories are NOT datasets for training;
+inspect them before retrying into another root. No upload or automatic deletion.
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+import traceback
+from pathlib import Path
+
+import numpy as np
+
+
+def explicit_device(device):
+    """Bare CUDA follows mutable simulator current-device state; pin it instead."""
+    return "cuda:0" if device == "cuda" else device
+
+
+def mark_completed():
+    """The shell owns this unique receipt; only a fully published run writes it."""
+    receipt = os.environ.get("RECAP_COMPLETION_RECEIPT")
+    if receipt:
+        Path(receipt).write_text("completed\n")
+
+
+def validate_seeds(seeds, split):
+    seeds = list(seeds)
+    allowed = range(4000, 4050) if split == "train" else range(9000, 10000)
+    if split not in ("train", "dev") or not seeds or len(set(seeds)) != len(seeds):
+        raise ValueError("Require a nonempty unique seed list and train/dev split")
+    if any(type(s) is not int or s not in allowed for s in seeds):
+        raise ValueError("train seeds must be 4000..4049; isolated dev seeds 9000..9999")
+    return seeds
+
+
+def validate_observation(state, images, shapes):
+    if state.shape != (16,) or not np.isfinite(state).all():
+        raise ValueError("Invalid 16-D state; no usable trajectory")
+    for key, shape in shapes.items():
+        image = images[key]
+        if image.shape != (*shape, 3) or image.dtype != np.uint8:
+            raise ValueError(f"Invalid RGB frame {key}: {image.shape}, {image.dtype}")
+
+
+def rollout(env, horizon, observe, select_action, record, arm_idx):
+    """Exact official pre-action success semantics, with a non-stepping o_T capture.
+
+    record receives (t, observation, actual_policy_action, applied_18D_target).
+    Endpoint is never passed to record and success is not checked at horizon.
+    """
+    if horizon < 1:
+        raise ValueError("Positive fixed task horizon required")
+    count, success, steps = 0, False, 0
+    for steps in range(1, horizon + 1):
+        env.success.update()
+        if env.success.success_original:
+            success = True
+            break
+        observation = observe()
+        action = np.asarray(select_action(observation), dtype=np.float32).reshape(-1)
+        if action.shape != (16,) or not np.isfinite(action).all():
+            raise ValueError("Policy must produce a finite 16-D action")
+        env.target[arm_idx] = action[:14]
+        env.grip_open["right"], env.grip_open["left"] = bool(action[14] > .5), bool(action[15] > .5)
+        env.finger_step()
+        target = env.target.copy()
+        env.apply(target)
+        record(count, observation, action.copy(), target)
+        count += 1
+    terminal = observe()  # TaskEnv.capture renders only; no update or physics step.
+    return {"success_original": success, "executed_actions": count,
+            "official_steps": steps, "terminal_observation_index": count,
+            "termination": "success_original" if success else "horizon"}, terminal
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def policy_identity(path):
+    path = Path(path).resolve()
+    files = sorted(p for p in path.rglob("*") if p.is_file() and p.suffix in (".json", ".safetensors"))
+    if not any(p.name == "model.safetensors" for p in files):
+        raise ValueError("Require a local saved SmolVLA pretrained_model with model.safetensors")
+    hashes = {str(p.relative_to(path)): sha256(p) for p in files}
+    return {"path": str(path), "files_sha256": hashes,
+            "sha256": hashlib.sha256(json.dumps(hashes, sort_keys=True).encode()).hexdigest()}
+
+
+def episode_paths(output, task, split, seed):
+    final = Path(output).resolve() / split / task / f"seed-{seed}"
+    pending = final.with_name(final.name + ".pending")
+    if final.exists() or pending.exists():
+        raise FileExistsError(f"Duplicate or interrupted seed; inspect without overwriting: {final}")
+    return final, pending
+
+
+def validate_saved_dataset(root, states, actions, shapes):
+    """Fresh disk check of all numeric rows and encoded RGB counts/dimensions."""
+    import av
+    import pyarrow.parquet as pq
+
+    info = json.loads((root / "meta/info.json").read_text())
+    n = len(actions)
+    if info["total_frames"] != n or info["total_episodes"] != 1 or info["fps"] != 15:
+        raise ValueError("Saved dataset counts/fps mismatch")
+    tables = [pq.read_table(p).to_pydict() for p in sorted((root / "data").rglob("*.parquet"))]
+    for key, expected in (("action", actions), ("observation.state", states)):
+        actual = np.asarray([row for table in tables for row in table[key]], dtype=np.float32)
+        if not np.array_equal(actual, np.asarray(expected, dtype=np.float32)):
+            raise ValueError(f"Saved numeric mismatch: {key}")
+    for key, expected in (("frame_index", list(range(n))), ("index", list(range(n))), ("episode_index", [0] * n)):
+        actual = [row for table in tables for row in table[key]]
+        if actual != expected:
+            raise ValueError(f"Saved frame join mismatch: {key}")
+    for key, shape in shapes.items():
+        videos = list((root / "videos" / f"observation.images.{key}").rglob("*.mp4"))
+        if len(videos) != 1:
+            raise ValueError(f"Expected exactly one video for {key}")
+        with av.open(str(videos[0])) as container:
+            if container.streams.video[0].codec_context.name not in ("av1", "libdav1d"):
+                raise ValueError("Expected official AV1 encoding")
+            frames = 0
+            for frame in container.decode(video=0):
+                if (frame.height, frame.width) != shape:
+                    raise ValueError(f"Encoded RGB shape mismatch: {key}")
+                frames += 1
+            if frames != n:
+                raise ValueError(f"Encoded RGB count mismatch: {key}")
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--policy-path", type=Path, required=True)
+    p.add_argument("--task", choices=[f"T{i}" for i in range(1, 11)], required=True)
+    p.add_argument("--output", type=Path, required=True)
+    p.add_argument("--split", choices=["train", "dev"], default="train")
+    p.add_argument("--seeds", type=int, nargs="+", help="Default train 4000..4019; dev must be explicit")
+    p.add_argument("--device", default="cuda:0", type=explicit_device)
+    p.add_argument("--n-action-steps", type=int)
+    args = p.parse_args()
+    if args.split == "dev" and args.seeds is None:
+        p.error("--split dev requires explicit --seeds")
+    if args.n_action_steps is not None and args.n_action_steps < 1:
+        p.error("--n-action-steps must be positive")
+    seeds = validate_seeds(args.seeds if args.seeds is not None else range(4000, 4020), args.split)
+    destinations = {seed: episode_paths(args.output, args.task, args.split, seed) for seed in seeds}
+    identity = policy_identity(args.policy_path)
+    import project_paths as paths
+
+    horizon_path = paths.ROOT / "vla_lab/eval_horizons.json"
+    horizon = int(json.loads(horizon_path.read_text())[args.task])
+    paths.prepare_assets()
+    import pinocchio  # noqa: F401 -- must precede Isaac Sim
+    from isaacsim import SimulationApp
+
+    app = SimulationApp({"headless": True, "width": 1440, "height": 900, "renderer": "RayTracedLighting"})
+    try:
+        import torch
+        from lerobot.datasets.lerobot_dataset import LeRobotDataset
+        from lerobot.policies.factory import make_pre_post_processors
+        from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy
+        import rby1_format as R
+        import sim_env
+
+        env = sim_env.TaskEnv(app, args.task, front_video_size=None)
+        instruction = env.meta["Language Instruction"]
+        arm_idx, _ = R._idx(env.names)
+        policy = SmolVLAPolicy.from_pretrained(str(args.policy_path))
+        policy.to(args.device).eval()
+        if args.n_action_steps is not None:
+            policy.config.n_action_steps = args.n_action_steps
+        pre, post = make_pre_post_processors(policy.config, pretrained_path=str(args.policy_path),
+                    preprocessor_overrides={"device_processor": {"device": args.device}})
+        features = {key: {"dtype": "float32", "shape": (16,), "names": R.NAMES}
+                    for key in ("action", "observation.state")}
+        for key, shape in R.IMAGE_SHAPES.items():
+            features[f"observation.images.{key}"] = {"dtype": "video", "shape": (*shape, 3),
+                                                     "names": ["height", "width", "channels"]}
+
+        def observe():
+            images, camera_times = env.capture()
+            state = R.state16(env.get_q()[None], env.names)[0]
+            images = {key: np.ascontiguousarray(images[cam]) for cam, key in R.CAMERA_KEYS.items()}
+            validate_observation(state, images, R.IMAGE_SHAPES)
+            return {"state": state, "images": images, "camera_times": np.asarray(camera_times).copy()}
+
+        def select_action(obs):
+            batch = {"observation.state": torch.from_numpy(obs["state"])[None].float(), "task": [instruction]}
+            for key, image in obs["images"].items():
+                batch[f"observation.images.{key}"] = torch.from_numpy(image).permute(2, 0, 1)[None].float() / 255.
+            with torch.inference_mode():
+                return post(policy.select_action(pre(batch))).float().cpu().numpy().reshape(-1)
+
+        for seed in seeds:
+            final, pending = destinations[seed]
+            final.parent.mkdir(parents=True, exist_ok=True)
+            # Exclusive creation also prevents parallel writers to the same seed.
+            pending.mkdir()
+            ds = None
+            try:
+                env.reset(seed)
+                started = time.monotonic()
+                policy.reset()
+                torch.manual_seed(seed)
+                states, actions, targets, times = [], [], [], []
+                ds = LeRobotDataset.create(repo_id=f"local/RECAP-{args.task}-{seed}", root=pending / "dataset",
+                         fps=R.FPS, features=features, robot_type=R.ROBOT_TYPE, video_backend="pyav",
+                         vcodec="libsvtav1", image_writer_threads=3)
+
+                def record(t, obs, action, target):
+                    if t != len(actions):
+                        raise ValueError("Noncontiguous action index")
+                    ds.add_frame({"task": instruction, "observation.state": obs["state"].copy(), "action": action.copy(),
+                                  **{f"observation.images.{k}": v for k, v in obs["images"].items()}})
+                    states.append(obs["state"].copy())
+                    actions.append(action.copy())
+                    targets.append(target.copy())
+                    times.append(obs["camera_times"].copy())
+
+                outcome, terminal = rollout(env, horizon, observe, select_action, record, arm_idx)
+                if not outcome["executed_actions"]:
+                    raise ValueError("No executed action: not a valid training trajectory")
+                np.savez_compressed(pending / "terminal_observation.npz", state=terminal["state"],
+                                    camera_times=terminal["camera_times"], **terminal["images"])
+                np.savez_compressed(pending / "execution.npz", states=np.asarray(states), actions=np.asarray(actions),
+                                    simulator_targets=np.asarray(targets), camera_times=np.asarray(times))
+                ds.save_episode(parallel_encoding=False)
+                ds.finalize()
+                validate_saved_dataset(pending / "dataset", states, actions, R.IMAGE_SHAPES)
+                manifest = {"schema_version": 1, "episode_id": f"recap-{args.split}-{args.task}-seed-{seed}",
+                            "task": args.task, "seed": seed, "split": args.split, "train_eligible": args.split == "train",
+                            "instruction": instruction, "action_source": "autonomous_policy", "policy": identity,
+                            "dataset": "dataset", "episode_index": 0, "actor_frame_indices": [0, len(actions)],
+                            "index_semantics": "half-open range; dataset index = frame_index; no terminal actor row",
+                            "terminal_observation": "terminal_observation.npz", "execution": "execution.npz",
+                            "horizon": horizon, "fps": R.FPS, "n_action_steps": policy.config.n_action_steps,
+                            "wall_seconds": time.monotonic() - started, "scene_sha256": sha256(env.scene),
+                            "policy_device": args.device,
+                            "self_collision": env.self_collision, "physics_dt": sim_env.PHYSICS_DT,
+                            "camera_paths": sim_env.CAMERA_PATHS,
+                            "success_label_source": "success_original", "outcome_semantics": "official pre-action check; no check after horizon",
+                            "joint_names": list(env.names), "action_names": R.NAMES, "camera_keys": R.CAMERA_KEYS,
+                            "mapping": "policy float32 16D postprocessed; first14 absolute arms; right/left >0.5 open; finger_step then apply",
+                            "camera_processing": "TaskEnv.capture already rotates left; no additional adaptation",
+                            "sources_sha256": {str(path.relative_to(paths.ROOT)): sha256(path) for path in
+                                (horizon_path, Path(__file__).resolve(), Path(sim_env.__file__).resolve(), Path(R.__file__).resolve(),
+                                 paths.ROOT / "vla_lab/scripts/eval_smolvla.py")}, **outcome}
+                (pending / "manifest.json").write_text(json.dumps(manifest, indent=2))
+                ds.stop_image_writer()
+                ds = None
+                pending.rename(final)
+                print("RECAP_EPISODE", json.dumps({"path": str(final), **outcome}), flush=True)
+            except Exception as exc:
+                (pending / "error.json").write_text(json.dumps({"seed": seed, "task": args.task,
+                    "usable": False, "error": repr(exc), "traceback": traceback.format_exc()}))
+                raise
+            finally:
+                if ds is not None:
+                    ds.stop_image_writer()
+                    ds.finalize()
+        mark_completed()
+    except BaseException:
+        # Isaac fast shutdown may exit(0) inside close(), before Python prints
+        # the pending exception. Preserve diagnostics before entering shutdown.
+        traceback.print_exc(file=sys.stderr)
+        sys.stderr.flush()
+        raise
+    finally:
+        app.close()
+
+
+if __name__ == "__main__":
+    main()
