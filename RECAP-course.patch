+import numpy as np
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts'))
+import fit_recap_value as fit
+from recap_processor import TrainingAdvantageStep
+
+
+def document():
+    episodes, start = [], 0
+    for i in range(4):
+        oracle = i < 2
+        count = 5 if oracle else 4
+        row = dict(episode_index=i, row_start=start, row_count=count, preterminal_actions=4,
+                   task='T1', task_index=3, instruction='Pick cube', source='oracle' if oracle else 'autonomous',
+                   seed=i if oracle else 4000+i, success=oracle, horizon=10)
+        row.update({'terminal_index': start + 4} if oracle else {'terminal_path': f'terminal_{i}.npz'})
+        episodes.append(row)
+        start += count
+    return dict(schema_version=1, dataset_id='local/test', episodes=episodes)
+
+
+def frame(ep, t):
+    return {'index': torch.tensor(ep['row_start'] + t), 'frame_index': torch.tensor(t),
+            'episode_index': torch.tensor(ep['episode_index']), 'task_index': torch.tensor(ep['task_index']),
+            'task': ep['instruction'], 'observation.state': torch.arange(16).float(),
+            'observation.images.front': torch.ones(3, 12, 16) * .25,
+            'observation.images.left': torch.ones(3, 16, 12) * .5,
+            'observation.images.right': torch.ones(3, 10, 14) * .75}
+
+
+class ValueDriverTests(unittest.TestCase):
+    def setUp(self):
+        self.doc = document()
+        self.episodes = self.doc['episodes']
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.frames = []
+        for ep in self.episodes:
+            self.frames.extend(frame(ep, t) for t in range(ep['row_count']))
+            if ep['source'] == 'autonomous':
+                np.savez(self.root / ep['terminal_path'], state=np.zeros(16, dtype=np.float32),
+                         front=np.zeros((12, 16, 3), dtype=np.uint8),
+                         left=np.zeros((16, 12, 3), dtype=np.uint8),
+                         right=np.zeros((10, 14, 3), dtype=np.uint8), camera_times=np.zeros(3))
+
+    def test_manifest_alignment_training_only(self):
+        self.assertEqual(fit.validate_manifest(self.doc, ('T1',)), self.episodes)
+        for change in (lambda d: d['episodes'][0].update(seed=100000),
+                       lambda d: d['episodes'][0].update(terminal_index=3),
+                       lambda d: d['episodes'][1].update(row_start=1),
+                       lambda d: d['episodes'][0].update(success=1),
+                       lambda d: d['episodes'][2].update(source='correction'),
+                       lambda d: d['episodes'][2].update(terminal_path=None)):
+            bad = copy.deepcopy(self.doc)
+            change(bad)
+            with self.assertRaises(ValueError):
+                fit.validate_manifest(bad, ('T1',))
+
+    def test_episode_disjoint_stratified_deterministic_folds(self):
+        folds = fit.episode_folds(self.episodes)
+        self.assertEqual(folds, fit.episode_folds(list(reversed(self.episodes))))
+        for source in ('oracle', 'autonomous'):
+            self.assertEqual({folds[e['episode_index']] for e in self.episodes if e['source'] == source}, {0, 1})
+        for fold in (0, 1):
+            train = {e['episode_index'] for e in self.episodes if folds[e['episode_index']] != fold}
+            valid = {e['episode_index'] for e in self.episodes if folds[e['episode_index']] == fold}
+            self.assertFalse(train & valid)
+            self.assertEqual(train | valid, set(range(4)))
+        with self.assertRaises(ValueError):
+            fit.episode_folds(self.episodes[:1])
+
+    def test_resize_separately_input_shapes(self):
+        camera, state, task = fit.prepare_inputs(self.frames[0], 'T1', 8)
+        self.assertEqual(camera.shape, (3, 3, 8, 8))
+        self.assertEqual(state.shape, (16,))
+        self.assertEqual(task.item(), 0)  # NOT arbitrary dataset task_index=3
+        torch.testing.assert_close(camera[:, 0, 0, 0], torch.tensor([.25, .5, .75]))
+        with self.assertRaises(ValueError):
+            fit.prepare_inputs({**self.frames[0], 'observation.state': torch.zeros(6)}, 'T1', 8)
+
+    def test_value_frames_terminal_and_stride_coverage(self):
+        full = fit.ValueFrames(self.frames, self.episodes, self.root, image_size=8)
+        sparse = fit.ValueFrames(self.frames, self.episodes, self.root, image_size=8, stride=3)
+        self.assertEqual(len(full), 20)
+        self.assertEqual(len(sparse), 12)
+        self.assertEqual([t for ep, t in sparse.samples[:3]], [0, 3, 4])
+        self.assertEqual(full[14][0].sum().item(), 0)  # raw NPZ endpoint, no fake dataset row
+        self.assertEqual(full[4][0].sum().item(), 288)  # actual oracle terminal row
+        self.frames[0]['index'] = torch.tensor(8)
+        with self.assertRaises(ValueError):
+            full[0]
+
+    def test_training_fold_constant_has_no_heldout_outcome(self):
+        train = self.episodes[:2]
+        means = fit.training_constants(train)
+        self.episodes[2]['success'] = True
+        self.assertEqual(means, fit.training_constants(train))
+        self.assertAlmostEqual(means['T1'], -.1)
+
+    def test_gate_exports_exact_actor_index_rows(self):
+        predictions = {e['episode_index']: fit.normalized_returns(4, 10, e['success']) -
+                       np.array([.01, .02, .03, .04, .01]) for e in self.episodes}
+        means = {e['episode_index']: -.4 for e in self.episodes}
+        report, rows = fit.gate_and_labels(self.episodes, predictions, means, required_tasks=('T1',))
+        self.assertTrue(report['passed'])
+        self.assertEqual(len(rows), 16)
+        self.assertEqual([r['index'] for r in rows], [e['row_start']+t for e in self.episodes for t in range(4)])
+        self.assertEqual({r['indicator'] for r in rows}, {0, 1})
+        path = self.root / 'labels.json'
+        path.write_text(json.dumps(dict(schema_version=1, dataset_id='local/test', rows=rows)))
+        processor = TrainingAdvantageStep(str(path), 'local/test', fit.sha256(path), dropout_probability=0)
+        batch = {key: [r[key] for r in rows] for key in ('index', 'episode_index', 'task_index', 'task')}
+        self.assertEqual(len(processor.complementary_data(batch)['task']), 16)
+
+    def test_gates_fail_closed_for_poor_or_collapsed_predictions(self):
+        means = {e['episode_index']: -.4 for e in self.episodes}
+        bad = {e['episode_index']: np.zeros(5) - 1 for e in self.episodes}
+        report, rows = fit.gate_and_labels(self.episodes, bad, means, required_tasks=('T1',))
+        self.assertFalse(report['passed'])
+        self.assertIsNone(rows)
+        perfect = {e['episode_index']: fit.normalized_returns(4, 10, e['success']) for e in self.episodes}
+        report, rows = fit.gate_and_labels(self.episodes, perfect, means, required_tasks=('T1',))
+        self.assertFalse(report['passed'])  # all A=0 -> strict percentile collapses
+        self.assertIn('indicator_error', report)
+        self.assertIsNone(rows)
+
+    def test_driver_failed_gate_writes_report_without_labels(self):
+        from argparse import Namespace
+        from unittest.mock import patch
+        mixed = self.root / 'mixed'
+        mixed.mkdir()
+        episodes, frames, start = [], [], 0
+        horizons = json.loads(Path(fit.__file__).resolve().parents[1].joinpath('eval_horizons.json').read_text())
+        for task in fit.TASKS:
+            for source in document()['episodes']:
+                ep = dict(source, task=task, task_index=fit.TASKS.index(task),
+                          instruction='Pick ' + task, episode_index=len(episodes),
+                          row_start=start, horizon=horizons[task])
+                if ep['source'] == 'oracle':
+                    ep['terminal_index'] = start + 4
+                else:
+                    ep['terminal_path'] = str(self.root / source['terminal_path'])
+                frames.extend(frame(ep, t) for t in range(ep['row_count']))
+                start += ep['row_count']
+                episodes.append(ep)
+        (mixed / 'recap_manifest.json').write_text(json.dumps(
+            dict(schema_version=1, dataset_id='local/test', episodes=episodes)))
+        args = Namespace(mixed_root=mixed, output=self.root / 'output', seed=1000,
+                         epochs=1, batch_size=32, train_stride=16, image_size=8,
+                         train_cache_mib=2048, learning_rate=.001, n_step=50,
+                         device='cpu', video_backend='pyav')
+        torch.set_num_threads(1)
+        # This fixture tests output transaction/CLI plumbing, not research viability.
+        with patch('lerobot.datasets.lerobot_dataset.LeRobotDataset', return_value=frames), \
+             patch.object(fit, 'validate_physical_metadata'), \
+             patch.object(fit, 'gate_and_labels', return_value=({'passed': False}, None)):
+            result = fit.run(args)
+        self.assertFalse(result['viable'])
+        self.assertFalse((args.output / 'advantage_labels.json').exists())
+        saved = json.loads((args.output / 'value_report.json').read_text())
+        self.assertNotIn('labels_sha256', saved)
+        self.assertEqual(saved['dataset_id'], 'local/test')
+        self.assertEqual(len(saved['folds']), 2)
+        self.assertTrue(all(fold['train_cache_bytes'] > 0 for fold in saved['folds']))
+        self.assertTrue((args.output / 'oof_predictions.npz').exists())
+        with self.assertRaises(FileExistsError):
+            fit.run(args)  # cannot accidentally consume stale output from a previous run
+
+    def test_cpu_fit_finite_logits_and_full_predictions(self):
+        torch.set_num_threads(1)
+        frames = fit.ValueFrames(self.frames, self.episodes[:2], self.root, image_size=8, stride=2)
+        model, history = fit.fit_model(frames, seed=1000, epochs=1, batch_size=4,
+                                       learning_rate=.001, device='cpu')
+        self.assertTrue(np.isfinite(history).all())
+        full = fit.ValueFrames(self.frames, self.episodes[2:], self.root, image_size=8)
+        predictions = fit.predict(model, full, batch_size=3, device='cpu')
+        self.assertEqual(predictions.shape, (10,))
+        self.assertTrue(np.isfinite(predictions).all())
+        self.assertTrue(((predictions >= -1) & (predictions <= 0)).all())
+
+    def test_cache_bounded_and_training_bitwise_equivalent(self):
+        torch.set_num_threads(1)
+        frames = fit.ValueFrames(self.frames, self.episodes[:3], self.root, image_size=8, stride=2)
+        exact_bytes = len(frames) * (3 * 3 * 8 * 8 * 4 + 16 * 4 + 2 * 8)
+        self.assertEqual(fit.cache_training_frames(frames, 0), (frames, 0))
+        self.assertEqual(fit.cache_training_frames(frames, exact_bytes - 1), (frames, 0))
+        cached, used = fit.cache_training_frames(frames, exact_bytes)
+        self.assertEqual(used, exact_bytes)
+        for i in range(len(frames)):
+            for decoded, stored in zip(frames[i], cached[i], strict=True):
+                self.assertTrue(torch.equal(torch.as_tensor(decoded), stored))
+        config = dict(seed=1000, epochs=2, batch_size=4, learning_rate=.001, device='cpu')
+        slow, slow_history = fit.fit_model(frames, **config)
+        fast, fast_history = fit.fit_model(cached, **config)
+        self.assertEqual(slow_history, fast_history)
+        for param in slow.state_dict():
+            self.assertTrue(torch.equal(slow.state_dict()[param], fast.state_dict()[param]), param)
+
+
+if __name__ == '__main__':
+    unittest.main()
