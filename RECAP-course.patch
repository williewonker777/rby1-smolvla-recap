+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts'))
+from recap_actor_data import EpisodeSpan
+from collect_recap_rollouts import policy_identity
+from train_recap_actor import TASKS, check_labels, check_rollout_policy, prepare_checkpoint, processor_files, sha
+
+
+class TrainRecapActorTests(unittest.TestCase):
+    def test_label_coverage_and_source_identity(self):
+        dataset_id, manifest_hash = 'local/RBY1-T1-T10-RECAP-MIXED', 'aa' * 32
+        spans = [EpisodeSpan(i, i*2, 2, 2, task, i, task, 'autonomous', 4000)
+                 for i, task in enumerate(TASKS)]
+        artifact = {'schema_version': 1, 'dataset_id': dataset_id, 'rows': [
+            {'index': b.row_start+j, 'episode_index': b.episode_index, 'task_index': b.task_index,
+             'task': b.instruction, 'indicator': j} for b in spans for j in (0, 1)]}
+        with tempfile.TemporaryDirectory() as repo:
+            labels, report = Path(repo) / 'labels.json', Path(repo) / 'value_report.json'
+
+            def verify():
+                labels.write_text(json.dumps(artifact))
+                report.write_text(json.dumps({'viable': True, 'dataset_id': dataset_id,
+                                              'manifest_sha256': manifest_hash, 'labels_sha256': sha(labels)}))
+                return check_labels(dataset_id, spans, manifest_hash, labels, report)
+
+            self.assertEqual(verify(), sha(labels))
+            artifact['rows'][0]['task'] = 'a different instruction with the same index'
+            with self.assertRaisesRegex(ValueError, 'identity mismatch'):
+                verify()
+            artifact['rows'][0]['task'] = 'T1'
+            artifact['rows'].pop()
+            with self.assertRaisesRegex(ValueError, 'cover every actor row'):
+                verify()
+
+    def test_reject_escaping_export_state(self):
+        with self.assertRaises(ValueError):
+            processor_files({'steps': [{'state_file': '../label_data.safetensors'}]})
+
+    def test_rollouts_bind_to_exact_b0_including_processor_state(self):
+        with tempfile.TemporaryDirectory() as repo:
+            base = Path(repo)
+            (base/'model.safetensors').write_bytes(b'example weight bytes')
+            (base/'policy_preprocessor.json').write_text('{}')
+            expected = policy_identity(base)['sha256']
+            rows = [{'source': 'oracle'}, {'source': 'autonomous', 'policy_sha256': expected, 'n_action_steps': 50}]
+            self.assertEqual(check_rollout_policy(rows, base), expected)
+            (base/'policy_preprocessor.json').write_text('{"changed":true}')
+            with self.assertRaisesRegex(ValueError, 'exact B0'):
+                check_rollout_policy(rows, base)
+
+    @unittest.skipUnless(os.environ.get('RECAP_STOCK_CHECKPOINT'), 'set actual smoke model path')
+    def test_actual_checkpoint_staging(self):
+        source = Path(os.environ['RECAP_STOCK_CHECKPOINT'])
+        with tempfile.TemporaryDirectory() as repo:
+            target = Path(repo) / 'pretrained_model'
+            prepare_checkpoint(source, target, 'unconditional')
+            self.assertEqual((target / 'model.safetensors').resolve(), (source / 'model.safetensors').resolve())
+            self.assertEqual(json.loads((target/'policy_postprocessor.json').read_text()),
+                             json.loads((source/'policy_postprocessor.json').read_text()))
+            steps = json.loads((target/'policy_preprocessor.json').read_text())['steps']
+            self.assertTrue(any(s.get('class') == 'recap_processor.ActionPaddingBridgeStep' for s in steps))
+            self.assertFalse(any(s.get('class', '').endswith('AdvantageStep') for s in steps))
+            self.assertFalse((target/'train_config.json').exists())
+
