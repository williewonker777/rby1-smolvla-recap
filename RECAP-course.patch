+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+SPEC = importlib.util.spec_from_file_location("recap_compare", Path(__file__).parents[1] / "scripts/recap_compare.py")
+module = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(module)
+
+
+class CompareTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.base = Path(self.temp.name) / "base"
+        self.candidate = Path(self.temp.name) / "candidate"
+        for root in (self.base, self.candidate):
+            for task in module.TASKS:
+                (root / task).mkdir(parents=True)
+                rows = [{"task": task, "seed": seed, "success": seed % 2 == 0}
+                        for seed in sorted(module.SEEDS)]
+                (root / task / "episodes.json").write_text(json.dumps(rows))
+
+    def mutate(self, edit):
+        path = self.candidate / "T1/episodes.json"
+        rows = json.loads(path.read_text())
+        edit(rows)
+        path.write_text(json.dumps(rows))
+
+    def test_identical(self):
+        result = module.compare(self.base, self.candidate, 100)
+        self.assertEqual(result["paired_ci95"], [0, 0])
+        self.assertEqual(result["baseline"], {"macro_mean": .5, "task_sample_sd": 0})
+        self.assertEqual(result["verdict"], "rules_out_5pp_gain_at_this_precision")
+
+    def test_pair_counts_determinism(self):
+        self.mutate(lambda rows: rows[1].update(success=True))
+        a = module.compare(self.base, self.candidate, 200, 7)
+        self.assertEqual(a, module.compare(self.base, self.candidate, 200, 7))
+        self.assertEqual((a["gains"], a["losses"], a["difference"]), (1, 0, .002))
+
+    def test_clear_gain(self):
+        for task in module.TASKS:
+            path = self.candidate / task / "episodes.json"
+            rows = json.loads(path.read_text())
+            for row in rows:
+                row["success"] = True
+            path.write_text(json.dumps(rows))
+        self.assertEqual(module.compare(self.base, self.candidate, 200)["verdict"], "supports_meaningful_gain")
+
+    def test_invalid_rows(self):
+        changes = [lambda r: r.pop(), lambda r: r.append(r[0]),
+                   lambda r: r[0].update(seed=9999), lambda r: r[0].update(task="T2"),
+                   lambda r: r[0].update(success=1), lambda r: r[0].pop("success"),
+                   lambda r: r[0].update(seed=True)]
+        path = self.candidate / "T1/episodes.json"
+        original = path.read_text()
+        for change in changes:
+            with self.subTest(change=change):
+                path.write_text(original)
+                self.mutate(change)
+                with self.assertRaises(ValueError):
+                    module.compare(self.base, self.candidate, 10)
+
+    def test_extra_and_missing_tasks(self):
+        extra = self.candidate / "T11"
+        extra.mkdir()
+        (extra / "episodes.json").write_text("[]")
+        with self.assertRaises(ValueError):
+            module.load_results(self.candidate)
+        (extra / "episodes.json").unlink()
+        (self.candidate / "T1/episodes.json").unlink()
+        with self.assertRaises(ValueError):
+            module.load_results(self.candidate)
+
+    def write_analysis(self, root, overrides=None):
+        overrides = overrides or {}
+        outcomes = module.load_results(root)
+        details, table = [], []
+        for task in module.TASKS:
+            counts = {stage: 0 for stage in module.STAGES}
+            for seed, success in outcomes[task].items():
+                if not success:
+                    stage = overrides.get((task, seed), "grasp")
+                    details.append({"task": task, "seed": seed, "stage": stage, "why": "synthetic fixture"})
+                    counts[stage] += 1
+            table.append({"task": task, "episodes": 50,
+                          "failures": 50 - sum(outcomes[task].values()), **counts})
+        (root / "failure_analysis.json").write_text(json.dumps({"table": table, "episodes": details}))
+
+    def test_optional_stage_leaves_binary_metrics_identical(self):
+        plain = module.compare(self.base, self.candidate, 100)
+        for root in (self.base, self.candidate):
+            self.write_analysis(root)
+        expanded = module.compare(self.base, self.candidate, 100, target_stage="grasp")
+        stage = expanded.pop("stage_comparison")
+        self.assertEqual(expanded, plain)
+        self.assertEqual(stage["target_paired_ci95"], [0, 0])
+        self.assertEqual(stage["overall"]["incidence"]["grasp"]["baseline_rate"], .5)
+        self.assertEqual(stage["tasks"][0]["incidence"]["grasp"]["baseline_rate"], .5)
+        self.assertEqual(stage["overall"]["transitions"]["grasp"]["grasp"], 250)
+        self.assertEqual(set(stage["overall"]["transitions"]), set(module.STATES))
+        self.assertTrue(all(set(row) == set(module.STATES) for row in stage["overall"]["transitions"].values()))
+
+    def test_hand_checked_transitions(self):
+        self.mutate(lambda rows: (rows[0].update(success=False), rows[1].update(success=True)))
+        self.write_analysis(self.base, {("T1", 100007): "transport"})
+        self.write_analysis(self.candidate, {("T1", 100003): "transport", ("T1", 100005): "unknown"})
+        result = module.compare(self.base, self.candidate, 200, 7, "grasp")
+        stage = result['stage_comparison']
+        total = stage['overall']
+        self.assertEqual((total['target_to_success'], total['target_to_other_failure'], total['newly_entered_target']), (1, 2, 2))
+        self.assertEqual(total['incidence']['grasp']['baseline_count'], 249)
+        self.assertEqual(total['incidence']['grasp']['candidate_count'], 248)
+        self.assertEqual(stage['target_difference'], -1 / 500)
+        self.assertEqual(total['incidence']['unknown']['candidate_count'], 1)
+        self.assertEqual(total['transitions']['grasp']['unknown'], 1)
+        self.assertEqual(total['transitions']['success']['grasp'], 1)
+        self.assertEqual(total['transitions']['transport']['grasp'], 1)
+        self.assertEqual(sum(sum(r.values()) for r in total['transitions'].values()), 500)
+        self.assertEqual(sum(sum(r.values()) for r in stage['tasks'][0]['transitions'].values()), 50)
+        self.assertEqual(stage['target_difference'], (total['newly_entered_target'] - total['target_to_success'] - total['target_to_other_failure']) / 500)
+        self.assertEqual(result, module.compare(self.base, self.candidate, 200, 7, "grasp"))
+        plain = module.compare(self.base, self.candidate, 200, 7)
+        self.assertEqual({k: v for k, v in result.items() if k != 'stage_comparison'}, plain)
+
+    def test_stage_bootstrap_direction_and_absent_target(self):
+        self.write_analysis(self.base)
+        self.write_analysis(self.candidate, {(t, s): 'transport' for t in module.TASKS for s in module.SEEDS})
+        result = module.compare(self.base, self.candidate, 100, target_stage='grasp')['stage_comparison']
+        self.assertEqual(result['target_difference'], -.5)
+        self.assertLess(result['target_paired_ci95'][1], 0)
+        absent = module.compare(self.base, self.candidate, 100, target_stage='approach')['stage_comparison']
+        self.assertEqual(absent['target_paired_ci95'], [0, 0])
+
+    def test_invalid_classifications(self):
+        for root in (self.base, self.candidate):
+            self.write_analysis(root)
+        path = self.candidate / 'failure_analysis.json'
+        original = path.read_text()
+        changes = [lambda d: d['episodes'].pop(), lambda d: d['episodes'].append(d['episodes'][0]),
+                   lambda d: d['episodes'][0].update(stage='invalid'),
+                   lambda d: d['episodes'][0].update(seed=100000),
+                   lambda d: d['episodes'][0].update(seed=9999),
+                   lambda d: d['episodes'][0].update(seed=True),
+                   lambda d: d['episodes'][0].update(task='T11'),
+                   lambda d: d['episodes'][0].update(success=0),
+                   lambda d: d['table'][0].update(grasp=24),
+                   lambda d: d['table'].pop(), lambda d: d['table'].append(d['table'][0])]
+        for change in changes:
+            with self.subTest(change=change):
+                data = json.loads(original)
+                change(data)
+                path.write_text(json.dumps(data))
+                with self.assertRaises(ValueError):
+                    module.compare(self.base, self.candidate, 10, target_stage='grasp')
+        path.unlink()
+        with self.assertRaises(OSError):
