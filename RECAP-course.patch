+"""Fit two episode-disjoint critics and export gated OOF RECAP labels.
+
+Real data only: LeRobot v0.4.3 mixed root + assembler recap_manifest.json.
+Training stride applies only to training observations; OOF evaluates every o0..oT.
+A failed gate writes diagnostics/models, but NEVER a usable labels sidecar.
+Defaults are declared before fitting, last epoch only; no validation selection.
+"""
+import argparse
+import hashlib
+import json
+import os
+from collections import defaultdict
+from pathlib import Path
+import time
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+from torch.utils.data import DataLoader, Dataset, TensorDataset
+
+from recap_value import (TASKS, DistributionalValue, categorical_targets,
+                         normalized_returns, oof_macro_gate, task_indicators,
+                         terminal_advantages)
+
+CAMERAS = ('front', 'left', 'right')
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def integer(value, name, minimum=0):
+    if type(value) is not int or value < minimum:
+        raise ValueError(f'{name} must be integer >= {minimum}')
+    return value
+
+
+def validate_manifest(document, required_tasks=TASKS):
+    if type(document.get('schema_version')) is not int or document.get('schema_version') != 1 or not isinstance(document.get('dataset_id'), str) or not document['dataset_id']:
+        raise ValueError('manifest schema_version/dataset_id missing')
+    episodes = document.get('episodes')
+    if not isinstance(episodes, list) or not episodes:
+        raise ValueError('manifest episodes must be nonempty')
+    end, seeds, identities, counts = 0, set(), {}, defaultdict(int)
+    fields = {'episode_index', 'row_start', 'row_count', 'preterminal_actions', 'task',
+              'task_index', 'instruction', 'source', 'seed', 'success', 'horizon'}
+    for i, ep in enumerate(episodes):
+        if not isinstance(ep, dict) or not fields <= ep.keys():
+            raise ValueError('incomplete episode metadata')
+        for key in ('episode_index', 'row_start', 'row_count', 'preterminal_actions', 'task_index', 'seed', 'horizon'):
+            integer(ep[key], key)
+        if ep['episode_index'] != i or ep['row_start'] != end:
+            raise ValueError('episodes/rows must be ordered and contiguous')
+        t = ep['preterminal_actions']
+        if not 0 < t <= ep['horizon'] or ep['row_count'] < t or type(ep['success']) is not bool:
+            raise ValueError('invalid canonical action count/horizon/outcome')
+        task, source, seed = ep['task'], ep['source'], ep['seed']
+        if task not in required_tasks or source not in ('oracle', 'autonomous'):
+            raise ValueError('unsupported task/source (corrections require separate verified implementation)')
+        if (source == 'oracle' and not 0 <= seed < 4000) or (source == 'autonomous' and not 4000 <= seed <= 4049):
+            raise ValueError('non-training or unapproved source seed')
+        if (task, seed) in seeds:
+            raise ValueError('duplicate task/seed')
+        seeds.add((task, seed))
+        counts[task] += 1
+        if counts[task] > 100 or len(episodes) > 1000:
+            raise ValueError('course episode cap exceeded')
+        if not isinstance(ep['instruction'], str) or not ep['instruction'].strip():
+            raise ValueError('instruction required')
+        identity = (ep['task_index'], ep['instruction'], ep['horizon'])
+        if task in identities and identities[task] != identity:
+            raise ValueError('inconsistent task identity/horizon')
+        identities[task] = identity
+        if source == 'oracle':
+            integer(ep.get('terminal_index'), 'terminal_index')
+            if ep.get('terminal_index') != ep['row_start'] + t or ep['row_count'] <= t or not ep['success']:
+                raise ValueError('oracle terminal_index must be absolute first-success row')
+        elif not isinstance(ep.get('terminal_path'), str) or not ep['terminal_path'] or ep['row_count'] != t:
+            raise ValueError('autonomous requires endpoint NPZ and exactly T physical rows')
+        end += ep['row_count']
+    if set(identities) != set(required_tasks) or len({v[0] for v in identities.values()}) != len(identities):
+        raise ValueError('missing tasks or ambiguous task indices')
+    return episodes
+
+
+def episode_folds(episodes, seed=1000):
+    """Two balanced folds within task/source; reject unsupported singleton strata."""
+    integer(seed, 'seed')
+    groups = defaultdict(list)
+    for ep in episodes:
+        groups[(ep['task'], ep['source'])].append(ep['episode_index'])
+    rng = np.random.default_rng(seed)
+    folds = {}
+    for key in sorted(groups):
+        ids = np.array(sorted(groups[key]), dtype=np.int64)
+        if len(ids) < 2:
+            raise ValueError(f'need at least two episodes in stratum {key}')
+        rng.shuffle(ids)
+        for offset, identity in enumerate(ids):
+            if int(identity) in folds:
+                raise ValueError('duplicate episode identity')
+            folds[int(identity)] = offset % 2
+    return folds
+
+
+def prepare_inputs(item, task, image_size=64, *, terminal=False):
+    """Resize each view independently BEFORE stacking; no outcomes enter model."""
+    integer(image_size, 'image_size', 8)
+    views = []
+    for camera in CAMERAS:
+        value = item[camera if terminal else f'observation.images.{camera}']
+        image = torch.as_tensor(np.array(value, copy=True)) if terminal else torch.as_tensor(value)
+        if terminal:
+            if image.dtype != torch.uint8 or image.ndim != 3 or image.shape[-1] != 3:
+                raise ValueError('terminal cameras must be HWC uint8')
+            image = image.permute(2, 0, 1).float() / 255
+        if image.ndim != 3 or image.shape[0] != 3 or not image.is_floating_point() or not torch.isfinite(image).all() or (image < 0).any() or (image > 1).any():
+            raise ValueError('dataset cameras must be CHW finite floats in [0,1]')
+        views.append(F.interpolate(image[None].float(), size=(image_size, image_size),
+                                   mode='bilinear', align_corners=False, antialias=True)[0])
+    state = torch.as_tensor(np.array(item['state'], copy=True)) if terminal else torch.as_tensor(item['observation.state'])
+    if state.shape != (16,) or not state.is_floating_point() or not torch.isfinite(state).all():
+        raise ValueError('observed state must be finite float [16]')
+    return torch.stack(views), state.float(), torch.tensor(TASKS.index(task), dtype=torch.int64)
+
+
+def check_item_identity(item, ep, offset):
+    for key, expected in (('index', ep['row_start'] + offset), ('frame_index', offset),
+                          ('episode_index', ep['episode_index']), ('task_index', ep['task_index'])):
+        value = item.get(key)
+        if isinstance(value, torch.Tensor):
+            if value.numel() != 1 or value.dtype not in (torch.int8, torch.int16, torch.int32, torch.int64, torch.uint8):
+                raise ValueError(f'invalid {key}')
+            value = value.item()
+        if type(value) is not int or value != expected:
+            raise ValueError(f'physical {key} join mismatch')
+    if item.get('task') != ep['instruction']:
+        raise ValueError('physical task instruction mismatch')
+
+
+class ValueFrames(Dataset):
+    def __init__(self, dataset, episodes, mixed_root, image_size=64, stride=1):
+        integer(stride, 'stride', 1)
+        self.dataset, self.root, self.image_size = dataset, Path(mixed_root), image_size
+        self.samples = []
+        self.targets = {}
+        for ep in episodes:
+            count = ep['preterminal_actions']
+            targets = normalized_returns(count, ep['horizon'], ep['success'])
+            self.targets[ep['episode_index']] = categorical_targets(targets)
+            for t in sorted(set(range(0, count + 1, stride)) | {count}):
+                self.samples.append((ep, t))
+
+    def __len__(self):
+        return len(self.samples)
+
+    def __getitem__(self, index):
+        ep, offset = self.samples[index]
+        terminal = offset == ep['preterminal_actions'] and ep['source'] == 'autonomous'
+        if terminal:
+            path = Path(ep['terminal_path'])
+            path = path if path.is_absolute() else self.root / path
+            with np.load(path, allow_pickle=False) as item:
+                inputs = prepare_inputs(item, ep['task'], self.image_size, terminal=True)
+        else:
+            item = self.dataset[ep['row_start'] + offset]
+            check_item_identity(item, ep, offset)
+            inputs = prepare_inputs(item, ep['task'], self.image_size)
+        return (*inputs, int(self.targets[ep['episode_index']][offset]))
+
+
+def training_constants(episodes):
+    """Equal episode weighting of all canonical observations, training fold only."""
+    grouped = defaultdict(list)
+    for ep in episodes:
+        grouped[ep['task']].append(float(normalized_returns(
+            ep['preterminal_actions'], ep['horizon'], ep['success']).mean()))
+    return {task: float(np.mean(values)) for task, values in grouped.items()}
+
+
+def gate_and_labels(episodes, predictions, fold_means, *, required_tasks=TASKS, n_step=50):
+    records, advantages, tasks, autonomous, rows = [], [], [], [], []
+    for ep in episodes:
+        identity, count = ep['episode_index'], ep['preterminal_actions']
+        pred = predictions[identity]
+        target = normalized_returns(count, ep['horizon'], ep['success'])
+        records.append({'task': ep['task'], 'episode_id': str(identity), 'targets': target,
+                        'predictions': pred, 'training_fold_mean': fold_means[identity]})
+        advantage = terminal_advantages(pred, count, ep['horizon'], ep['success'], n_step)
+        advantages.extend(advantage.tolist())
+        tasks.extend([ep['task']] * count)
+        autonomous.extend([ep['source'] == 'autonomous'] * count)
+        rows.extend({'index': ep['row_start'] + t, 'episode_index': identity,
+                     'task_index': ep['task_index'], 'task': ep['instruction']} for t in range(count))
+    report = oof_macro_gate(records, required_tasks)
+    try:
+        indicators, thresholds = task_indicators(advantages, tasks, np.asarray(autonomous, dtype=bool),
+                                                 required_tasks=required_tasks)
+        report['thresholds'] = thresholds
+    except ValueError as error:
+        report.update(passed=False, reason='indicator_support_failed', indicator_error=str(error))
+        return report, None
+    if not report['passed']:
+        return report, None
+    for row, flag in zip(rows, indicators, strict=True):
+        row['indicator'] = int(flag)
+    if len({row['index'] for row in rows}) != len(rows):
+        raise ValueError('duplicate absolute label indices')
+    return report, rows
+
+
+def cache_training_frames(frames, limit_bytes):
+    """Keep one fold's deterministic, resized CPU inputs, not held-out frames."""
+    integer(limit_bytes, 'limit_bytes')
+    if not limit_bytes or not len(frames):
+        return frames, 0
+    first = tuple(torch.as_tensor(value) for value in frames[0])
+    size = len(frames) * sum(value.numel() * value.element_size() for value in first)
+    if size > limit_bytes:
+        return frames, 0
+    columns = tuple(torch.empty((len(frames), *value.shape), dtype=value.dtype, device='cpu') for value in first)
+    for index in range(len(frames)):
+        row = first if index == 0 else frames[index]
+        for column, value in zip(columns, row, strict=True):
+            value = torch.as_tensor(value)
+            if value.shape != column.shape[1:] or value.dtype != column.dtype:
+                raise ValueError('training cache input shape or dtype changed')
+            column[index].copy_(value)
+    return TensorDataset(*columns), size
+
+
+def fit_model(frames, *, seed, epochs, batch_size, learning_rate, device):
+    """Fixed-budget fit, last epoch checkpoint, isolated deterministic loader RNG."""
+    torch.manual_seed(seed)
+    if str(device).startswith('cuda'):
+        torch.cuda.manual_seed_all(seed)
+    model = DistributionalValue().to(device)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=learning_rate)
+    generator = torch.Generator().manual_seed(seed)
+    loader = DataLoader(frames, batch_size=batch_size, shuffle=True, num_workers=0,
+                        generator=generator)
+    history = []
+    model.train()
+    for epoch in range(epochs):
+        total, count = 0., 0
+        for cameras, state, task, target in loader:
+            optimizer.zero_grad(set_to_none=True)
+            logits = model(cameras.to(device), state.to(device), task.to(device))
+            loss = F.cross_entropy(logits, target.to(device))
+            if not torch.isfinite(loss):
+                raise ValueError('nonfinite critic training loss')
+            loss.backward()
+            if any(p.grad is not None and not torch.isfinite(p.grad).all() for p in model.parameters()):
+                raise ValueError('nonfinite critic gradient')
+            optimizer.step()
+            total += loss.item() * len(target)
+            count += len(target)
+        history.append(total / count)
+        print(json.dumps({'epoch': epoch + 1, 'cross_entropy': history[-1]}), flush=True)
+    return model, history
+
+
+def predict(model, frames, batch_size, device):
+    loader = DataLoader(frames, batch_size=batch_size, shuffle=False, num_workers=0)
+    values = []
+    model.eval()
+    with torch.inference_mode():
+        for cameras, state, task, _ in loader:
+            values.extend(model.expected_value(cameras.to(device), state.to(device), task.to(device)).cpu().tolist())
+    return np.asarray(values, dtype=np.float64)
+
+
+def validate_physical_metadata(dataset, episodes):
+    if dataset.episodes is not None or dataset.delta_indices is not None:
+        raise ValueError('critic requires complete raw dataset with no action/observation deltas')
+    dataset._ensure_hf_dataset_loaded()
+    total = sum(ep['row_count'] for ep in episodes)
+    if len(dataset) != total or dataset.meta.total_frames != total or dataset.meta.total_episodes != len(episodes):
+        raise ValueError('manifest/physical dataset size mismatch')
+    if dataset.fps != 15:
+        raise ValueError('course dataset must use 15fps')
+    for ep in episodes:
+        meta = dataset.meta.episodes[ep['episode_index']]
+        if (meta['dataset_from_index'] != ep['row_start'] or
+                meta['dataset_to_index'] != ep['row_start'] + ep['row_count'] or
+                meta['length'] != ep['row_count']):
+            raise ValueError('physical episode metadata differs from manifest')
+        for key, expected in (
+            ('index', range(ep['row_start'], ep['row_start'] + ep['row_count'])),
+            ('frame_index', range(ep['row_count'])),
+            ('episode_index', [ep['episode_index']] * ep['row_count']),
+            ('task_index', [ep['task_index']] * ep['row_count']),
+        ):
+            column = dataset.hf_dataset.select_columns([key])[ep['row_start']:ep['row_start'] + ep['row_count']][key]
+            actual = []
+            for value in column:
+                if isinstance(value, torch.Tensor):
+                    if value.numel() != 1 or value.dtype not in (torch.int8, torch.int16, torch.int32, torch.int64, torch.uint8):
+                        raise ValueError(f'invalid physical {key} type')
+                    value = value.item()
+                actual.append(integer(value, key))
+            if actual != list(expected):
+                raise ValueError(f'physical full-column {key} join mismatch')
+
+
+def run(args):
+    from lerobot.datasets.lerobot_dataset import LeRobotDataset
+    root, output = args.mixed_root.resolve(), args.output.resolve()
+    if output == root or root in output.parents:
+        raise ValueError('output must be outside immutable mixed dataset')
+    manifest_path = root / 'recap_manifest.json'
+    manifest = json.loads(manifest_path.read_text())
+    episodes = validate_manifest(manifest)
+    horizons = json.loads(Path(__file__).resolve().parents[1].joinpath('eval_horizons.json').read_text())
+    if any(ep['horizon'] != horizons[ep['task']] for ep in episodes):
+        raise ValueError('manifest horizon differs from frozen course configuration')
+    folds = episode_folds(episodes, args.seed)
+    integer(args.epochs, 'epochs', 1)
+    integer(args.batch_size, 'batch_size', 1)
+    integer(args.train_stride, 'train_stride', 1)
+    integer(args.train_cache_mib, 'train_cache_mib')
+    integer(args.n_step, 'n_step', 1)
+    integer(args.image_size, 'image_size', 8)
+    if not np.isfinite(args.learning_rate) or args.learning_rate <= 0:
+        raise ValueError('learning_rate must be positive finite')
+    if args.seed != 1000:
+        raise ValueError('course training seed must be 1000')
+    output.mkdir(parents=True, exist_ok=False)  # never reuse stale passing labels
+    report = {'viable': False, 'dataset_id': manifest['dataset_id'],
+              'manifest_sha256': sha256(manifest_path), 'config': vars(args) | {
+                  'mixed_root': str(root), 'output': str(output)},
+              'camera_order': CAMERAS, 'critic_task_mapping': list(TASKS),
+              'training_constant': 'per-task mean of full-observation episode means in TRAIN fold only',
+              'oof_coverage': 'all canonical observations including terminals',
+              'training_frame_stride': args.train_stride, 'fold_assignment': folds,
+              'optimizer': {'name': 'AdamW', 'lr': args.learning_rate, 'betas': [0.9, 0.999],
+                            'eps': 1e-8, 'weight_decay': 0.01},
+              'checkpoint_selection': 'last epoch; no validation-based selection',
+              'sources_sha256': {name: sha256(Path(__file__).with_name(name))
+                                 for name in ('fit_recap_value.py', 'recap_value.py')},
+              'torch_version': torch.__version__, 'numpy_version': np.__version__}
+    started = time.monotonic()
+    try:
+        os.environ.setdefault('CUBLAS_WORKSPACE_CONFIG', ':4096:8')
+        torch.use_deterministic_algorithms(True)
+        torch.backends.cudnn.benchmark = False
+        dataset = LeRobotDataset(manifest['dataset_id'], root=root, video_backend=args.video_backend)
+        validate_physical_metadata(dataset, episodes)
+        # Freeze actual local inputs, not just directory names or loader ordering.
+        report['input_files_sha256'] = {
+            str(path.relative_to(root)): sha256(path) for section in ('meta', 'data', 'videos')
+            for path in sorted((root / section).rglob('*')) if path.is_file()}
+        report['terminal_files_sha256'] = {
+            ep['terminal_path']: sha256(root / ep['terminal_path'])
+            for ep in episodes if ep['source'] == 'autonomous'}
+        predictions, constants, fold_reports = {}, {}, []
+        for heldout_fold in (0, 1):
+            train = [ep for ep in episodes if folds[ep['episode_index']] != heldout_fold]
+            heldout = [ep for ep in episodes if folds[ep['episode_index']] == heldout_fold]
+            train_frames = ValueFrames(dataset, train, root, args.image_size, args.train_stride)
+            training_inputs, cached_bytes = cache_training_frames(train_frames, args.train_cache_mib * 1024**2)
+            model, history = fit_model(training_inputs, seed=args.seed, epochs=args.epochs,
+                                       batch_size=args.batch_size, learning_rate=args.learning_rate,
+                                       device=args.device)
+            del training_inputs
+            checkpoint = output / f'value_fold_{heldout_fold}.pt'
+            torch.save({'state_dict': model.cpu().state_dict(), 'heldout_fold': heldout_fold,
+                        'training_episode_ids': [ep['episode_index'] for ep in train],
+                        'image_size': args.image_size, 'camera_order': CAMERAS,
+                        'task_mapping': TASKS, 'manifest_sha256': report['manifest_sha256']}, checkpoint)
+            model.to(args.device)
+            means = training_constants(train)
+            for ep in heldout:
+                frames = ValueFrames(dataset, [ep], root, args.image_size, stride=1)
+                predictions[ep['episode_index']] = predict(model, frames, args.batch_size, args.device)
+                constants[ep['episode_index']] = means[ep['task']]
+            fold_reports.append({'heldout_fold': heldout_fold,
+                                 'train_episodes': [ep['episode_index'] for ep in train],
+                                 'validation_episodes': [ep['episode_index'] for ep in heldout],
+                                 'train_samples': len(train_frames), 'epochs': args.epochs,
+                                 'train_cache_bytes': cached_bytes,
+                                 'optimizer_updates': args.epochs * ((len(train_frames) + args.batch_size - 1) // args.batch_size),
+                                 'cross_entropy': history, 'training_task_constants': means,
+                                 'checkpoint_sha256': sha256(checkpoint)})
+            del model
+        np.savez_compressed(output / 'oof_predictions.npz', **{
+            f'episode_{identity}': values for identity, values in predictions.items()})
+        gate, rows = gate_and_labels(episodes, predictions, constants, n_step=args.n_step)
+        report.update(gate=gate, folds=fold_reports, viable=bool(gate['passed']))
+        report['per_source'] = {}
+        for source in ('oracle', 'autonomous'):
+            records = [{'task': ep['task'], 'episode_id': str(ep['episode_index']),
+                        'targets': normalized_returns(ep['preterminal_actions'], ep['horizon'], ep['success']),
+                        'predictions': predictions[ep['episode_index']],
+                        'training_fold_mean': constants[ep['episode_index']]}
+                       for ep in episodes if ep['source'] == source]
+            report['per_source'][source] = oof_macro_gate(records)
+        if report['viable']:
+            labels = output / 'advantage_labels.json'
+            labels.write_text(json.dumps({'schema_version': 1, 'dataset_id': manifest['dataset_id'],
+                                          'rows': rows}, indent=2) + '\n')
+            report['labels_sha256'] = sha256(labels)
+            report['label_rows'] = len(rows)
+        report['oof_predictions_sha256'] = sha256(output / 'oof_predictions.npz')
+    except Exception as error:
+        report.update(viable=False, error=f'{type(error).__name__}: {error}')
+        report.pop('labels_sha256', None)
+        (output / 'advantage_labels.json').unlink(missing_ok=True)
+        raise
+    finally:
+        report['elapsed_seconds'] = time.monotonic() - started
+        (output / 'value_report.json').write_text(json.dumps(report, indent=2) + '\n')
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--mixed-root', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--seed', type=int, default=1000)
+    parser.add_argument('--epochs', type=int, default=10)
+    parser.add_argument('--train-stride', type=int, default=16)
+    parser.add_argument('--train-cache-mib', type=int, default=2048,
+                        help='CPU limit for exact, per-fold training tensors; 0 disables the cache')
+    parser.add_argument('--batch-size', type=int, default=64)
+    parser.add_argument('--image-size', type=int, default=64)
+    parser.add_argument('--learning-rate', type=float, default=1e-3)
+    parser.add_argument('--n-step', type=int, default=50)
+    parser.add_argument('--device', default='cuda')
+    parser.add_argument('--video-backend', default='pyav', choices=('pyav', 'torchcodec'))
+    report = run(parser.parse_args())
+    print(json.dumps({'viable': report['viable'], 'gate': report['gate']}))
+    return 0 if report['viable'] else 2
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
